<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Easyaller.App.DomainPasswordWindow"
        Title="Присоединить к домену"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
  <StackPanel Margin="22,20" Spacing="14">
    <StackPanel Spacing="6">
      <TextBlock Text="Присоединить этот компьютер к домену" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock x:Name="AccountText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>
    <Border Classes="calloutWarning">
      <TextBlock Text="Присоединение изменит вход, политики и права на этом ПК; после него потребуется перезагрузка. Пароль используется только для этой операции, не сохраняется в профиле и не попадает в журнал." TextWrapping="Wrap" Classes="helperText" />
    </Border>
    <StackPanel Spacing="5">
      <TextBlock Text="Пароль доменной учётной записи" Classes="fieldLabel" />
      <TextBox x:Name="PasswordTextBox" PasswordChar="•" MinWidth="360" />
      <TextBlock x:Name="ErrorText" Classes="validationError" IsVisible="False" />
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Content="Отмена" Click="Cancel_Click" Classes="ghost" IsCancel="True" />
      <Button Grid.Column="2" Content="Присоединить" Click="Confirm_Click" Classes="warningAction" IsDefault="True" />
    </Grid>
  </StackPanel>
</Window>
