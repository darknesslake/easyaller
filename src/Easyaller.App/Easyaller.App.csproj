<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Easyaller.Core\Easyaller.Core.csproj" />
    <ProjectReference Include="..\Easyaller.Deployment\Easyaller.Deployment.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EmbeddedProfilePath)' != '' and Exists('$(EmbeddedProfilePath)')">
    <EmbeddedResource Include="$(EmbeddedProfilePath)"
                      LogicalName="Easyaller.EmbeddedProfile.wpprofile.json" />
  </ItemGroup>

</Project>
