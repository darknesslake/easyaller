<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.UsbCreatorWindow"
        x:DataType="local:UsbCreatorWindow"
        Title="Easyaller - Создать установочный USB"
        Width="900"
        Height="700"
        MinWidth="760"
        MinHeight="580"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16">
    <StackPanel Spacing="3">
      <TextBlock Text="Создать установочный USB" Classes="pageTitle" />
      <TextBlock Text="Показываются только подходящие съёмные диски. Внутренние, system и boot-диски скрыты." Classes="pageSubtitle" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <Border Classes="panelCard" Padding="14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <StackPanel Orientation="Horizontal">
                <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                  <TextBlock Text="Выберите съёмный диск" Classes="panelTitle" />
                  <TextBlock Text="Диск не выбирается автоматически. Неподходящие диски не показываются." Classes="helperText" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Content="Обновить" Click="RefreshCandidates_Click" Classes="ghost" VerticalAlignment="Top" />
            </Grid>
            <ListBox x:Name="CandidatesList" SelectionChanged="CandidatesList_SelectionChanged" MinHeight="60" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceSunkenBrush}" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:UsbCreatorCandidate}">
                  <StackPanel Spacing="1" Margin="8,5">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Classes="panelCard" Padding="14">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal">
              <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
              <TextBlock Text="Укажите источники" Classes="panelTitle" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Установочные файлы Windows и ранее экспортированный пакет Easyaller. Источники только читаются." Classes="helperText" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <TextBox x:Name="SetupMediaDirectoryTextBox" IsReadOnly="True" FontSize="12" Padding="8,5" PlaceholderText="ISO или каталог Windows Setup" />
              <Button Grid.Column="1" x:Name="ChooseSetupIsoButton" Content="Выбрать ISO…" Click="ChooseSetupIso_Click" Classes="ghost" ToolTip.Tip="Монтирует образ только для чтения и берёт файлы прямо из него. Распаковывать ISO вручную не нужно." />
              <Button Grid.Column="2" Content="Каталог…" Click="ChooseSetupMedia_Click" Classes="ghost" ToolTip.Tip="Если установочные файлы Windows уже распакованы в папку." />
            </Grid>
            <TextBlock x:Name="SetupIsoStatusText" Classes="helperText" TextWrapping="Wrap" IsVisible="False" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox x:Name="DeploymentPackageDirectoryTextBox" IsReadOnly="True" FontSize="12" Padding="8,5" PlaceholderText="Каталог пакета Easyaller" />
              <Button Grid.Column="1" Content="Выбрать…" Click="ChooseDeploymentPackage_Click" Classes="ghost" />
            </Grid>
            <Button x:Name="PrepareConfirmationButton" Content="Проверить источники" Click="PrepareConfirmation_Click" HorizontalAlignment="Left" Classes="primary" />
          </StackPanel>
        </Border>

        <Border Classes="calloutDanger" Padding="14">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal">
              <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0" Background="{StaticResource DangerBrush}">
                <TextBlock Text="3" Classes="stepBadgeText" Foreground="White" />
              </Border>
              <TextBlock Text="Необратимое подтверждение" Classes="panelTitle" Foreground="{StaticResource DangerTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ConfirmationDetailsText" Text="Сначала выберите диск и пройдите проверку источников." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox x:Name="ErasePhraseTextBox" FontSize="12" Padding="8,5" PlaceholderText="Введите ERASE заглавными буквами" />
            <TextBlock Text="Перед копированием диск и его том проверяются повторно. Непустой том, замена диска или несовпадение хэшей блокируют запись." Classes="helperText" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="bottomBar" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="UsbStatusText" Text="На Windows обновите список, затем явно выберите только нужный съёмный диск." TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Grid.Column="1" x:Name="WriteUsbButton" Content="Создать установочный USB" Click="WriteUsb_Click" Classes="danger primaryLarge" />
      </Grid>
    </Border>
  </Grid>
</Window>
