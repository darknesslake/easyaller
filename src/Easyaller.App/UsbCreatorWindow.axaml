<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.UsbCreatorWindow"
        x:DataType="local:UsbCreatorWindow"
        Title="Easyaller - Создать установочный USB"
        Width="960"
        Height="720"
        MinWidth="780"
        MinHeight="600"
        Background="#101826">
  <Grid RowDefinitions="Auto,*,Auto" Margin="32,28">
    <StackPanel Spacing="6">
      <TextBlock Text="Создать установочный USB" FontSize="28" FontWeight="SemiBold" Foreground="#F7F9FE" />
      <TextBlock Text="Показываются только подходящие съёмные диски. Внутренние, system и boot-диски скрыты." TextWrapping="Wrap" Foreground="#A9B7CD" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,24,0,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18">
        <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="1. Выберите съёмный диск" FontWeight="SemiBold" Foreground="#EAF0FA" />
                <TextBlock Text="Диск не выбирается автоматически. Обновление не показывает неподходящие диски." FontSize="12" Foreground="#9EB0CC" />
              </StackPanel>
              <Button Grid.Column="1" Content="Обновить список" Click="RefreshCandidates_Click" />
            </Grid>
            <ListBox x:Name="CandidatesList" SelectionChanged="CandidatesList_SelectionChanged" Height="156" Background="#101826" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:UsbCreatorCandidate}">
                  <Border Padding="12,9" Margin="0,3" CornerRadius="7">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF3FC" />
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Foreground="#9EB0CC" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="2. Укажите источники" FontWeight="SemiBold" Foreground="#EAF0FA" />
            <TextBlock Text="Выберите распакованные установочные файлы Windows и ранее экспортированный package Easyaller. ISO и package не изменяются." FontSize="12" TextWrapping="Wrap" Foreground="#9EB0CC" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox x:Name="SetupMediaDirectoryTextBox" IsReadOnly="True" PlaceholderText="Каталог Windows Setup" />
              <Button Grid.Column="1" Content="Выбрать Setup" Click="ChooseSetupMedia_Click" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox x:Name="DeploymentPackageDirectoryTextBox" IsReadOnly="True" PlaceholderText="Каталог deployment package" />
              <Button Grid.Column="1" Content="Выбрать package" Click="ChooseDeploymentPackage_Click" />
            </Grid>
            <Button x:Name="PrepareConfirmationButton" Content="Проверить источники и подготовить подтверждение" Click="PrepareConfirmation_Click" HorizontalAlignment="Left" Background="#2D6CDF" Foreground="White" />
          </StackPanel>
        </Border>

        <Border Background="#2A1E25" BorderBrush="#6B3948" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel Spacing="12">
            <TextBlock Text="3. Необратимое подтверждение" FontWeight="SemiBold" Foreground="#FFD5DD" />
            <TextBlock x:Name="ConfirmationDetailsText" Text="Сначала выберите диск и пройдите проверку источников." TextWrapping="Wrap" Foreground="#EBC5CF" />
            <TextBox x:Name="ErasePhraseTextBox" PlaceholderText="Введите ERASE заглавными буквами" />
            <Button x:Name="WriteUsbButton" Content="Создать установочный USB" Click="WriteUsb_Click" HorizontalAlignment="Left" Background="#B13B55" Foreground="White" />
            <TextBlock Text="Перед копированием программа повторно проверит диск и его том. Непустой том, замена диска или несовпадение хэшей блокируют операцию." TextWrapping="Wrap" FontSize="12" Foreground="#EBC5CF" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#182537" CornerRadius="8" Padding="14" Margin="0,18,0,0">
      <TextBlock x:Name="UsbStatusText" Text="На Windows обновите список, затем явно выберите только нужный съёмный диск." TextWrapping="Wrap" Foreground="#B7C7E1" />
    </Border>
  </Grid>
</Window>
