<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="Easyaller"
        Width="1140"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        Background="#101826">
  <Grid ColumnDefinitions="250,*">
    <Border Background="#151E2D" BorderBrush="#27364E" BorderThickness="0,0,1,0" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="easyaller" FontSize="25" FontWeight="SemiBold" Foreground="#F6F8FC" />
          <TextBlock Text="Windows provisioning" FontSize="12" Foreground="#8EA1C2" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="8">
          <Border Background="#263A5A" CornerRadius="8" Padding="12,10">
            <TextBlock Text="Profiles" FontWeight="SemiBold" Foreground="#F6F8FC" />
          </Border>
          <TextBlock Text="Set up this PC" Margin="12,7" Foreground="#9BAAC3" />
          <TextBlock Text="Prepare Windows 11" Margin="12,7" Foreground="#9BAAC3" />
          <TextBlock Text="Create installation USB" Margin="12,7" Foreground="#9BAAC3" />
        </StackPanel>

        <Border Grid.Row="3" Background="#1D2A3E" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Pre-alpha" FontWeight="SemiBold" Foreground="#93C5FD" />
            <TextBlock Text="Profiles are stored locally." TextWrapping="Wrap" FontSize="12" Foreground="#A8B6CC" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="34,28,34,28">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="6">
          <TextBlock Text="Profiles" FontSize="30" FontWeight="SemiBold" Foreground="#F7F9FE" />
          <TextBlock Text="Reusable settings with no stored credentials." Foreground="#A9B7CD" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Import" Click="ImportProfile_Click" />
          <Button Content="Export" Click="ExportProfile_Click" IsEnabled="{Binding HasSelectedProfile}" />
          <Button Content="New profile" Click="CreateProfile_Click" Background="#2D6CDF" Foreground="White" Padding="18,10" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.35*" ColumnSpacing="20">
        <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="12">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Text="Saved profiles" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="8,6,8,12" />
            <ListBox x:Name="ProfilesList" Grid.Row="1" SelectionChanged="ProfilesList_SelectionChanged" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ProfileListItem}">
                  <Border Padding="10" Margin="0,2" CornerRadius="7">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF3FC" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="Refresh list" Click="Refresh_Click" HorizontalAlignment="Left" Margin="8,12,8,4" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="26">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
            <TextBlock Text="{Binding SelectedProfileName}" FontSize="22" FontWeight="SemiBold" Foreground="#F7F9FE" />
            <TextBlock Grid.Row="1" Text="{Binding SelectedProfileDescription}" TextWrapping="Wrap" Foreground="#A9B7CD" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
              <Border Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding SelectedProfileRevision}" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Grid.Column="1" Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="No credentials" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Grid.Column="2" Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="Validated format" Foreground="#A9CCFF" FontSize="12" /></Border>
            </Grid>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="0,10,0,0">
              <TextBlock Text="Edit profile" FontWeight="SemiBold" Foreground="#EAF0FA" />
              <StackPanel Spacing="6">
                <TextBlock Text="Name" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileNameTextBox" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Description" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileDescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
              </StackPanel>
              <Expander Header="Windows and machine settings">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Windows editions" FontSize="12" Foreground="#A9B7CD" />
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <CheckBox x:Name="ProfessionalEditionCheckBox" Content="Windows 11 Pro" />
                    <CheckBox x:Name="EnterpriseEditionCheckBox" Content="Windows 11 Enterprise" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="UI language" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="UiLanguageTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Time zone" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="TimeZoneTextBox" PlaceholderText="UTC" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Input locale" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InputLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="System locale" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="SystemLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Text="User locale" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="UserLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                  </Grid>
                  <CheckBox x:Name="OfflineInitialSetupCheckBox" Content="Request offline initial setup" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Wireless setup in OOBE" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideWirelessSetupComboBox">
                        <ComboBoxItem Tag="unset">Not configured</ComboBoxItem>
                        <ComboBoxItem Tag="true">Hide</ComboBoxItem>
                        <ComboBoxItem Tag="false">Show</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Online account screens" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideOnlineAccountComboBox">
                        <ComboBoxItem Tag="unset">Not configured</ComboBoxItem>
                        <ComboBoxItem Tag="true">Hide</ComboBoxItem>
                        <ComboBoxItem Tag="false">Show</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Computer name prefix" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ComputerNamePrefixTextBox" PlaceholderText="Optional, for example OFFICE" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Proxy configuration" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="ProxyModeComboBox">
                        <ComboBoxItem>NotConfigured</ComboBoxItem>
                        <ComboBoxItem>PromptAtRuntime</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Domain mode" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="DomainModeComboBox">
                        <ComboBoxItem>NotConfigured</ComboBoxItem>
                        <ComboBoxItem>Optional</ComboBoxItem>
                        <ComboBoxItem>Required</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Provisioner launch" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="LaunchModeComboBox">
                        <ComboBoxItem>Manual</ComboBoxItem>
                        <ComboBoxItem>FirstLogon</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Text="Temporary account cleanup" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="CleanupModeComboBox">
                        <ComboBoxItem>DisableAfterValidation</ComboBoxItem>
                        <ComboBoxItem>DeleteAfterValidation</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Privacy preference" FontSize="12" Foreground="#A9B7CD" />
                    <ComboBox x:Name="PrivacyPreferenceComboBox">
                      <ComboBoxItem Tag="retain">Retain individual preferences</ComboBoxItem>
                      <ComboBoxItem Tag="NotConfigured">Not configured for all privacy controls</ComboBoxItem>
                      <ComboBoxItem Tag="UserChoice">User choice for all privacy controls</ComboBoxItem>
                      <ComboBoxItem Tag="Enabled">Enable all privacy controls</ComboBoxItem>
                      <ComboBoxItem Tag="Disabled">Disable all privacy controls</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander Header="Applications and instructions">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Applications" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <ListBox x:Name="ApplicationsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding DisplayName}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Application ID" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationIdTextBox" PlaceholderText="example-app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Display name" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationDisplayNameTextBox" PlaceholderText="Example application" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Source" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="ApplicationSourceComboBox">
                        <ComboBoxItem>PackageRelative</ComboBoxItem>
                        <ComboBoxItem>ExternalManual</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Package-relative path" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationPathTextBox" PlaceholderText="installers/example.msi" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Arguments, one per line" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="ApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Add application" Click="AddApplication_Click" />
                    <Button Content="Remove selected application" Click="RemoveApplication_Click" />
                  </StackPanel>
                  <TextBlock Text="Instructions" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="0,8,0,0" />
                  <ListBox x:Name="InstructionsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding Title}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Instruction ID" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionIdTextBox" PlaceholderText="post-install" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Title" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionTitleTextBox" PlaceholderText="After setup" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Instruction text" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="InstructionContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Add instruction" Click="AddInstruction_Click" />
                    <Button Content="Remove selected instruction" Click="RemoveInstruction_Click" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Button Content="Save changes" Click="SaveProfile_Click" IsEnabled="{Binding HasSelectedProfile}" HorizontalAlignment="Left" />
              <Border Background="#1D2A3E" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Storage" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" FontSize="12" Foreground="#9EB0CC" />
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
              <Button Content="Clone" Click="CloneProfile_Click" IsEnabled="{Binding HasSelectedProfile}" />
              <CheckBox x:Name="ConfirmDeleteCheckBox" Grid.Column="2" Content="I understand this removes the local profile" VerticalAlignment="Center" Foreground="#A9B7CD" />
              <Button Grid.Column="3" Content="Delete" Click="DeleteProfile_Click" IsEnabled="{Binding HasSelectedProfile}" Background="#5F2631" Foreground="White" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
        <Border Background="#182537" CornerRadius="8" Padding="14">
          <TextBlock x:Name="StatusText" Text="Ready. Create a profile to get started." Foreground="#B7C7E1" />
        </Border>
        <Border x:Name="ImportConflictPanel" IsVisible="False" Background="#3A2D16" BorderBrush="#896A25" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="This profile ID already exists. Choose how to continue." VerticalAlignment="Center" Foreground="#F5DFA0" />
            <Button Grid.Column="1" Content="Create copy" Click="ImportCreateCopy_Click" />
            <Button Grid.Column="2" Content="Replace" Click="ImportReplace_Click" Background="#725C22" Foreground="White" />
            <Button Grid.Column="3" Content="Cancel" Click="ImportCancel_Click" />
          </Grid>
        </Border>
        <Border x:Name="ExportConfirmationPanel" IsVisible="False" Background="#1B3140" BorderBrush="#35667E" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ExportWarningText" VerticalAlignment="Center" Foreground="#B9E3F5" />
            <Button Grid.Column="1" Content="Confirm export" Click="ConfirmExport_Click" Background="#2D6CDF" Foreground="White" />
            <Button Grid.Column="2" Content="Cancel" Click="CancelExport_Click" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
