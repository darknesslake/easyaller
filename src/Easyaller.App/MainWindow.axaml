<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="Easyaller"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="720"
        Closing="MainWindow_Closing"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="28,24">
      <StackPanel Spacing="11" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="Easyaller" Classes="pageTitle" />
              <Border Classes="tag" VerticalAlignment="Center" ToolTip.Tip="Профили хранятся локально на этом компьютере.">
                <TextBlock Text="Пре-альфа" Classes="tagText" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="ModeSubtitleText" Text="Профиль описывает стандарт подготовки компьютера. Пароли и учётные данные не сохраняются." Classes="pageSubtitle" MaxWidth="620" HorizontalAlignment="Left" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Button Content="Импорт" Click="ImportProfile_Click" Classes="ghost" />
            <Button Content="Экспорт" Click="ExportProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" Classes="ghost" />
            <Button Content="Новый профиль" Click="CreateProfile_Click" Classes="primary" Padding="14,7" />
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="Режим:" Classes="fieldLabel" VerticalAlignment="Center" />
          <Border Classes="segmentGroup" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button x:Name="ThisPcModeButton" Classes="segment active" Click="SelectThisPcMode_Click" ToolTip.Tip="Windows уже установлена на этом компьютере — применяем к ней профиль.">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="segmentIcon" Text="🖥" />
                  <StackPanel Spacing="1">
                    <TextBlock Classes="segmentTitle" Text="Настроить этот компьютер" />
                    <TextBlock Classes="segmentHint" Text="Windows уже установлена" />
                  </StackPanel>
                </StackPanel>
              </Button>
              <Button x:Name="NewInstallModeButton" Classes="segment" Click="SelectNewInstallMode_Click" ToolTip.Tip="Готовим файлы и установочный носитель для Windows, которую только предстоит установить.">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="segmentIcon" Text="💿" />
                  <StackPanel Spacing="1">
                    <TextBlock Classes="segmentTitle" Text="Подготовить установку Windows" />
                    <TextBlock Classes="segmentHint" Text="Пакет и установочный USB" />
                  </StackPanel>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="224,*" ColumnSpacing="14">
        <Border Classes="panelCard" Padding="9">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
            <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,0">
              <TextBlock Text="Профили" Classes="fieldLabel" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ProfileListCountText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
            <TextBox x:Name="ProfileSearchTextBox" Grid.Row="1" PlaceholderText="Поиск" FontSize="12" Padding="8,5" TextChanged="ProfileSearchTextBox_TextChanged" IsEnabled="{Binding CanSearchProfiles}" />
            <Grid Grid.Row="2">
              <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ProfileListItem}">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,4" ColumnSpacing="6">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="tagAccent" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RevisionLabel}" Classes="tagAccentText" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding HasNoVisibleProfiles}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Margin="14">
                <TextBlock Text="Профили не найдены" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Измените запрос или создайте новый профиль." TextWrapping="Wrap" TextAlignment="Center" Classes="helperText" />
              </StackPanel>
            </Grid>
            <Button Grid.Row="3" Content="Обновить" Click="Refresh_Click" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="panelCard" Padding="18">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="11">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SelectedProfileName}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Border Grid.Column="1" IsVisible="{Binding HasUnsavedChanges}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                <TextBlock Text="Не сохранено" Foreground="{StaticResource WarningTextBrush}" FontSize="10.5" FontWeight="SemiBold" />
              </Border>
            </Grid>
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <Border Classes="tag"><TextBlock Text="{Binding SelectedProfileRevision}" Classes="tagText" /></Border>
              <Border Classes="tag" Margin="6,0,0,0" ToolTip.Tip="Профиль не хранит пароли, токены и учётные данные домена."><TextBlock Text="Без учётных данных" Classes="tagText" /></Border>
            </WrapPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
              <Button x:Name="EditTabButton" Classes="tabPill active" Content="Профиль" Click="ShowEditTab_Click" />
              <Button x:Name="ApplyTabButton" Classes="tabPill" Content="Применить на этом ПК" Click="ShowApplyTab_Click" />
              <Button x:Name="VerifyTabButton" Classes="tabPill" Content="Проверка" Click="ShowVerifyTab_Click" ToolTip.Tip="Сверяет текущую Windows с профилем. Только чтение, ничего не меняет." />
            </StackPanel>
            <ScrollViewer x:Name="ProfileEditorScrollViewer" Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="9" Margin="0,6,0,0">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Название" Classes="fieldLabel" />
                  <TextBox x:Name="ProfileNameTextBox" FontSize="12" Padding="8,5" />
                  <TextBlock x:Name="ProfileNameErrorText" Classes="validationError" IsVisible="False" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Описание" Classes="fieldLabel" />
                  <TextBox x:Name="ProfileDescriptionTextBox" FontSize="12" Padding="8,5" AcceptsReturn="True" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ProfileSummaryText" Text="Выберите профиль" Classes="helperText" Margin="2,0" />
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleWindowsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock x:Name="WindowsSectionTitleText" Text="Windows и первый запуск" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Настройки, которые будут использованы при подготовке новой Windows. Они не изменяют уже работающий компьютер.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="WindowsSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="WindowsSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="WindowsSectionContent" IsVisible="False" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="14">
                <StackPanel Spacing="12">
                  <TextBlock x:Name="WindowsSectionNoteText" Text="Это стандарт для устанавливаемой Windows. Он не меняет уже работающий компьютер." Classes="noteText" />
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Часовой пояс" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Задаёт системное время Windows. Единственная настройка этого раздела, которую можно применить к уже установленной Windows.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="TimeZoneComboBox" HorizontalAlignment="Left" MinWidth="320">
                      <ComboBoxItem Tag="UTC">UTC (универсальное координированное время)</ComboBoxItem>
                      <ComboBoxItem Tag="West Asia Standard Time">UTC+05:00 (West Asia Standard Time)</ComboBoxItem>
                      <ComboBoxItem Tag="Central Asia Standard Time">UTC+06:00 (Central Asia Standard Time)</ComboBoxItem>
                      <ComboBoxItem Tag="Russian Standard Time">UTC+03:00 (Russian Standard Time)</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Системная зона Windows для часов, расписаний и журналов событий." Classes="helperText" />
                  </StackPanel>
                  <Border Classes="quickActionOnPc">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                      <Button x:Name="ApplyTimeZoneToCurrentPcButton" Content="Применить часовой пояс на этом ПК" HorizontalAlignment="Left" Click="ApplyTimeZoneToCurrentPc_Click" Classes="warningAction" />
                      <TextBlock Text="Меняет только часовой пояс Windows прямо сейчас. Кнопка «Сохранить» внизу страницы сохраняет лишь профиль и не трогает этот компьютер." Classes="helperText" />
                    </StackPanel>
                  </Border>

                  <StackPanel x:Name="InstallOnlyWindowsSettings" Spacing="12">
                    <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="10,7">
                      <TextBlock Text="Ниже — параметры файла ответов Windows Setup. Они действуют только при установке новой Windows и на этот компьютер не влияют." Classes="helperText" />
                    </Border>
                    <StackPanel Spacing="6">
                      <TextBlock Text="Поддерживаемые редакции" Classes="fieldLabel" />
                      <TextBlock Text="Профиль можно применить только к отмеченным редакциям Windows 11." Classes="helperText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                      <CheckBox x:Name="ProfessionalEditionCheckBox" Content="Windows 11 Pro" />
                      <CheckBox x:Name="EnterpriseEditionCheckBox" Content="Windows 11 Enterprise" />
                    </StackPanel>
                    <TextBlock x:Name="WindowsEditionErrorText" Classes="validationError" IsVisible="False" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Язык интерфейса" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Определяет язык меню, кнопок и основных системных диалогов Windows.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="UiLanguageComboBox">
                          <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                          <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Язык, на котором пользователь видит Windows после установки." Classes="helperText" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Системный язык" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Определяет язык программ без собственного выбора языка и системных форматов по умолчанию.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="SystemLocaleComboBox">
                          <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                          <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Язык по умолчанию для системных компонентов и программ." Classes="helperText" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6" HorizontalAlignment="Left" MinWidth="320">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Язык пользователя" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="Определяет региональный язык нового профиля пользователя: даты, числа и другие пользовательские форматы.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="UserLocaleComboBox">
                        <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                        <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Региональный язык для нового профиля пользователя." Classes="helperText" />
                    </StackPanel>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Языки ввода" Classes="fieldLabel" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Classes="helpBadge" ToolTip.Tip="Easyaller всегда добавляет обе раскладки, чтобы после установки можно было переключаться между английским и русским вводом.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="English (en-US) + Русский (ru-RU)" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                      <TextBlock Text="Обе раскладки сохраняются в профиле автоматически. Ручной ввод кода языка не нужен." Classes="helperText" />
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="OfflineInitialSetupCheckBox" Content="Подготовить автономный первый запуск" />
                      <Border Classes="helpBadge" ToolTip.Tip="Выберите для сценария, где первоначальная настройка Windows должна пройти без обязательного подключения к интернету.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="Скрывает часть экранов, которые требуют интернет или учётную запись. Используйте только для подходящего сценария установки." Classes="helperText" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Экран подключения к сети" Classes="fieldLabel" />
                      <ComboBox x:Name="HideWirelessSetupComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Экран онлайн-учётной записи" Classes="fieldLabel" />
                      <ComboBox x:Name="HideOnlineAccountComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Общие параметры конфиденциальности" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Единая настройка для поддерживаемых параметров геолокации, рекламы и персонализации. «Не настраивать» сохраняет текущее поведение Windows.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="PrivacyPreferenceComboBox">
                      <ComboBoxItem Tag="retain">Сохранить отдельные параметры</ComboBoxItem>
                      <ComboBoxItem Tag="NotConfigured">Не настраивать все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="UserChoice">Оставить выбор пользователю</ComboBoxItem>
                      <ComboBoxItem Tag="Enabled">Включить все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="Disabled">Отключить все параметры</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Выберите единый режим для служб геолокации, рекламы и персонализации. «Не настраивать» ничего не меняет." Classes="helperText" />
                  </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="WindowsSettingsErrorText" Classes="validationError" IsVisible="False" />
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleNetworkSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="Сеть и доступ" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Профиль может хранить статические сетевые параметры и правила WinHTTP-прокси. Адаптер и адрес прокси выбираются перед применением.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="NetworkSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="NetworkSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="NetworkSectionContent" IsVisible="False" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="14">
                <StackPanel Spacing="12">
                  <TextBlock Text="Выберите, что профиль должен помнить о сети. Сам сетевой адаптер всегда выбирается перед применением." Classes="noteText" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Шаблон имени компьютера" Classes="fieldLabel" />
                    <TextBlock Text="Начало имени: URA01" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox x:Name="ComputerNameTypeComboBox">
                      <ComboBoxItem Tag="NOMAD">NOMAD</ComboBoxItem>
                      <ComboBoxItem Tag="THINK">THINK</ComboBoxItem>
                      <ComboBoxItem Tag="Custom">Свой вариант</ComboBoxItem>
                    </ComboBox>
                    <TextBox x:Name="ComputerNameCustomTypeTextBox" PlaceholderText="Свой тип, только буквы и цифры" />
                    <TextBox x:Name="ComputerNameNumberTextBox" PlaceholderText="Номер текущего ПК: 2 или 3 цифры" />
                    <TextBlock x:Name="ComputerNamePrefixErrorText" Classes="validationError" IsVisible="False" />
                    <TextBlock Text="Итоговое имя задаётся при применении: URA01 + выбранный тип + 2 или 3 цифры, без дефисов. Например, URA01NOMAD01." Classes="helperText" />
                    <Border Classes="quickActionOnPc">
                      <StackPanel Spacing="6">
                        <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Взять имя с этого ПК" Click="TakeComputerNameFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Разбирает текущее имя компьютера на шаблон профиля. Windows не изменяется." />
                          <Button x:Name="ApplyComputerNameToCurrentPcButton" Content="Применить имя на этом ПК" Click="ApplyComputerNameToCurrentPc_Click" Classes="warningAction" />
                        </StackPanel>
                        <TextBlock Text="«Применить» переименовывает этот компьютер прямо сейчас и требует перезагрузку." Classes="helperText" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Сеть" Classes="cardTitle" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Режим сети" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Ручной режим не хранит адреса. Статический режим сохраняет IPv4, маску и шлюз в профиле для повторяемой настройки; DNS-серверы можно добавить, но они необязательны.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="NetworkModeComboBox">
                          <ComboBoxItem Tag="PromptAtRuntime">Выбрать параметры вручную перед применением</ComboBoxItem>
                          <ComboBoxItem Tag="StaticIpv4">Сохранить статический IPv4, маску и шлюз (DNS — по желанию)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Статический режим сохраняет адреса в профиле. Используйте его только для известных рабочих мест и не публикуйте такой профиль." Classes="helperText" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="IPv4-адрес" Classes="fieldLabel" />
                          <TextBox x:Name="StaticIpv4AddressTextBox" PlaceholderText="Заполняется только для статической сети" />
                          <TextBlock x:Name="StaticIpv4AddressErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Маска подсети" Classes="fieldLabel" />
                          <TextBox x:Name="StaticIpv4SubnetMaskTextBox" PlaceholderText="Например, 255.255.255.0" />
                          <TextBlock x:Name="StaticIpv4SubnetMaskErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Шлюз по умолчанию" Classes="fieldLabel" />
                            <Border Classes="tag" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="Необязательно" Classes="tagText" />
                            </Border>
                            <Border Classes="helpBadge" ToolTip.Tip="Оставьте пустым для изолированной подсети без выхода наружу. Если шлюз задан, он должен быть в той же подсети, что и адрес.">
                              <TextBlock Classes="helpBadgeText" Text="i" />
                            </Border>
                          </StackPanel>
                          <TextBox x:Name="StaticIpv4DefaultGatewayTextBox" PlaceholderText="Пусто — сеть без выхода наружу" />
                          <TextBlock x:Name="StaticIpv4DefaultGatewayErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Сетевой адаптер" Classes="fieldLabel" />
                          <TextBox x:Name="StaticIpv4AdapterIdTextBox" PlaceholderText="Точное имя или GUID адаптера Windows" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="DNS-серверы" Classes="fieldLabel" />
                          <Border Classes="tag" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Необязательно" Classes="tagText" />
                          </Border>
                          <Border Classes="helpBadge" ToolTip.Tip="До трёх адресов, без повторов. Если список пуст, DNS-серверы адаптера остаются без изменений — адрес, маска и шлюз всё равно применяются.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <Grid>
                          <ListBox x:Name="DnsServersList" Classes="compactList" Height="76" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="DnsServersList_SelectionChanged" />
                          <TextBlock IsVisible="{Binding HasNoDnsServers}" IsHitTestVisible="False" Text="DNS не задан — текущие DNS-серверы адаптера не изменятся" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" Classes="helperText" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox x:Name="DnsServerInputTextBox" PlaceholderText="Например, 10.0.0.1" KeyDown="DnsServerInputTextBox_KeyDown" />
                          <Button Grid.Column="1" x:Name="AddDnsServerButton" Content="+ Добавить" Click="AddDnsServer_Click" />
                          <Button Grid.Column="2" x:Name="RemoveDnsServerButton" Content="Удалить" Classes="ghost" Click="RemoveDnsServer_Click" />
                        </Grid>
                        <TextBlock x:Name="StaticIpv4DnsServersErrorText" Classes="validationError" IsVisible="False" />
                        <TextBlock Text="До трёх адресов, без повторов. Нажмите «+ Добавить» или Enter после ввода адреса. Оставьте список пустым, чтобы не трогать DNS." Classes="helperText" />
                      </StackPanel>
                      <Border Classes="quickActionOnPc">
                        <StackPanel Spacing="6">
                          <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Взять сеть с этого ПК" Click="TakeNetworkFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает текущие адрес, маску, шлюз и DNS активного адаптера и подставляет их в профиль. Windows не изменяется." />
                            <Button x:Name="ApplyStaticIpv4ToCurrentPcButton" Content="Применить сеть на этом ПК" Click="ApplyStaticIpv4ToCurrentPc_Click" Classes="warningAction" />
                          </StackPanel>
                          <TextBlock Text="«Взять» только читает настройки Windows. «Применить» меняет адрес и маску выбранного адаптера прямо сейчас; шлюз и DNS — лишь если заданы выше." Classes="helperText" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Прокси для системных служб Windows" Classes="cardTitle" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Нужно настраивать WinHTTP-прокси?" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Это отдельное системное хранилище прокси для служб (например, Windows Update), а НЕ тот прокси, что виден в Параметры → Сеть → Прокси и используется браузером. Их настройки друг с другом не связаны. Адрес не сохраняется в профиле.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="ProxyModeComboBox">
                          <ComboBoxItem Tag="NotConfigured">Нет, не менять настройки прокси</ComboBoxItem>
                          <ComboBoxItem Tag="PromptAtRuntime">Да, запросить адрес прокси перед применением</ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="ProxyAddressTextBox" PlaceholderText="Адрес WinHTTP-прокси, например proxy.example.test:8080" />
                        <TextBlock Text="Адрес и исключения сохраняются в профиле для запроса во время применения. Это WinHTTP, не прокси браузера из Параметров Windows." Classes="helperText" />
                        <Border Classes="quickActionOnPc">
                          <StackPanel Spacing="6">
                            <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="Взять прокси с этого ПК" Click="TakeProxyFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает текущий WinHTTP-прокси (netsh winhttp show proxy) и список исключений. Прокси браузера из Параметров Windows — другое хранилище и не читается. Windows не изменяется." />
                              <Button x:Name="ApplyProxyToCurrentPcButton" Content="Применить прокси на этом ПК" Click="ApplyProxyToCurrentPc_Click" Classes="warningAction" />
                            </StackPanel>
                            <TextBlock Text="«Применить» меняет только WinHTTP-прокси текущего ПК прямо сейчас. Прокси в Параметры → Сеть → Прокси не меняется и не читается." Classes="helperText" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Исключения для WinHTTP-прокси" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Адреса и шаблоны из списка открываются без прокси. Настройка применяется только к WinHTTP, а не автоматически ко всем браузерам.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <TextBox x:Name="ProxyBypassListTextBox" PlaceholderText="Необязательно: *.example.test, &lt;local&gt;, 192.0.2.53" />
                        <TextBlock x:Name="ProxyBypassListErrorText" Classes="validationError" IsVisible="False" />
                        <TextBlock Text="Адреса и шаблоны, которые должны подключаться без прокси. Введите через запятую. Это работает для WinHTTP, а не автоматически для всех браузеров." Classes="helperText" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleDomainSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="3" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="Домен и запуск настройки" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Правила для домена и запуска Easyaller. Пароль домена никогда не сохраняется в профиле.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="DomainSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="DomainSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="DomainSectionContent" IsVisible="False" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="14">
                <StackPanel Spacing="12">
                  <TextBlock Text="Эти правила определяют, когда Easyaller запускается и требуется ли присоединение к домену. Учётные данные всегда вводятся позднее и не сохраняются." Classes="noteText" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Присоединение к домену" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="«Не присоединять» ничего не меняет. «Предложить» позволяет пропустить шаг. «Запросить» не позволит применить профиль без данных домена.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="DomainModeComboBox">
                        <ComboBoxItem Tag="NotConfigured">Не присоединять к домену</ComboBoxItem>
                        <ComboBoxItem Tag="Optional">Предложить присоединение при настройке</ComboBoxItem>
                        <ComboBoxItem Tag="Required">Запросить домен перед применением</ComboBoxItem>
                      </ComboBox>
                      <TextBox x:Name="DomainNameTextBox" PlaceholderText="Домен, например contoso.local" />
                      <TextBox x:Name="DomainUserNameTextBox" PlaceholderText="Учётная запись домена" />
                      <TextBox x:Name="DomainPasswordTextBox" PasswordChar="•" PlaceholderText="Пароль — не сохраняется" />
                    </StackPanel>
                    <StackPanel x:Name="InstallOnlyLaunchSettings" Grid.Column="1" Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Когда запускать Easyaller" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="Относится только к устанавливаемой Windows: ручной запуск оставляет управление оператору, «первый вход» открывает Easyaller после первого входа.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="LaunchModeComboBox">
                        <ComboBoxItem Tag="Manual">Запускать вручную</ComboBoxItem>
                        <ComboBoxItem Tag="FirstLogon">Открыть при первом входе</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Только для новой установки. На уже работающий компьютер это не влияет." Classes="helperText" />
                    </StackPanel>
                  </Grid>
                  <Border Classes="quickActionOnPc">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Взять домен с этого ПК" Click="TakeDomainFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает домен, в котором состоит этот компьютер. Учётные данные не читаются и не сохраняются." />
                        <Button x:Name="ApplyDomainToCurrentPcButton" Content="Присоединить к домену на этом ПК" Click="ApplyDomainToCurrentPc_Click" Classes="warningAction" />
                      </StackPanel>
                      <TextBlock Text="«Применить» присоединяет этот компьютер к домену прямо сейчас и может потребовать перезагрузку. Пароль используется только для этой операции и не сохраняется." Classes="helperText" />
                    </StackPanel>
                  </Border>
                  <StackPanel x:Name="InstallOnlyCleanupSettings" Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Временная учётная запись подготовки" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Только для новой установки: после успешной проверки временную учётную запись можно отключить или удалить. Обычные учётные записи это не затрагивает.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="CleanupModeComboBox">
                      <ComboBoxItem Tag="DisableAfterValidation">Отключить после успешной проверки</ComboBoxItem>
                      <ComboBoxItem Tag="DeleteAfterValidation">Удалить после успешной проверки</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Это правило сработает только после подтверждённой проверки. Оно не удаляет обычные учётные записи пользователя." Classes="helperText" />
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="InstallOnlyApplicationsSection">
                <Button Classes="profileSectionButton" Click="ToggleApplicationsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="4" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="Приложения и ручные инструкции" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Приложение описывает установку из пакета или ручной источник. Инструкция хранит текст для оператора и никогда не исполняется как команда.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="ApplicationsSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="ApplicationsSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="ApplicationsSectionContent" IsVisible="False" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0" Padding="14">
                <StackPanel Spacing="12">
                  <TextBlock Text="Добавляйте только то, что нужно повторять для каждого компьютера. Инструкция описывает ручной шаг и не исполняется как команда." Classes="noteText" />
                  <TextBlock x:Name="ApplicationsErrorText" Classes="validationError" IsVisible="False" />
                  <TextBlock Text="Приложения" Classes="cardTitle" />
                  <ListBox x:Name="ApplicationsList" Height="96" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID приложения" Classes="fieldLabel" />
                      <TextBox x:Name="ApplicationIdTextBox" PlaceholderText="example-app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Отображаемое название" Classes="fieldLabel" />
                      <TextBox x:Name="ApplicationDisplayNameTextBox" PlaceholderText="Пример приложения" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Источник" Classes="fieldLabel" />
                      <ComboBox x:Name="ApplicationSourceComboBox">
                        <ComboBoxItem Tag="PackageRelative">Из пакета</ComboBoxItem>
                        <ComboBoxItem Tag="ExternalManual">Внешняя ручная установка</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Путь внутри пакета" Classes="fieldLabel" />
                      <TextBox x:Name="ApplicationPathTextBox" PlaceholderText="installers/example.msi" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Аргументы, по одному в строке" Classes="fieldLabel" />
                    <TextBox x:Name="ApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить приложение" Click="AddApplication_Click" />
                    <Button Content="Удалить выбранное приложение" Click="RemoveApplication_Click" />
                  </StackPanel>
                  <TextBlock Text="Инструкции" Classes="cardTitle" Margin="0,8,0,0" />
                  <ListBox x:Name="InstructionsList" Height="96" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Id}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID инструкции" Classes="fieldLabel" />
                      <TextBox x:Name="InstructionIdTextBox" PlaceholderText="post-install" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Заголовок" Classes="fieldLabel" />
                      <TextBox x:Name="InstructionTitleTextBox" PlaceholderText="После настройки" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Текст инструкции" Classes="fieldLabel" />
                    <TextBox x:Name="InstructionContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить инструкцию" Click="AddInstruction_Click" />
                    <Button Content="Удалить выбранную инструкцию" Click="RemoveInstruction_Click" />
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,4,2,0">
                <TextBlock Text="Хранилище:" Classes="helperText" />
                <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" Classes="helperText" />
              </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PrepareInstallScrollViewer" Grid.Row="3" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Подготовка установки Windows 11" Classes="cardTitle" />
                    <TextBlock Text="Здесь ничего не применяется к этому компьютеру. Собирается пакет файлов для Windows, которую только предстоит установить." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border Classes="calloutWarning">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Что флешка настроит сама, а что нет" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
                    <TextBlock Text="Файл ответов autounattend.xml автоматизирует установку частично: языки, раскладки, часовой пояс и выбранные экраны первичной настройки." TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Имя компьютера, статический IPv4, DNS, прокси, присоединение к домену и приложения в файл ответов не попадают. Профиль кладётся на носитель, но запускать его после установки пока некому: автозапуск Easyaller при первом входе в этой сборке не включается. Эти шаги выполняются вручную через режим «Настроить этот компьютер»." TextWrapping="Wrap" Classes="helperText" />
                  </StackPanel>
                </Border>

                <Border Classes="innerCard">
                  <StackPanel Spacing="7">
                    <TextBlock Text="ПЕРЕНОС НАСТРОЕК" Classes="quickActionLabel" Foreground="{StaticResource AccentTextBrush}" />
                    <Button Content="↓ Скопировать настройки этого компьютера в профиль" Click="TakeEverythingFromCurrentPc_Click" Classes="ghost" HorizontalAlignment="Left" ToolTip.Tip="Читает имя, сеть, домен и прокси текущей Windows и записывает их в профиль одним действием. Windows не изменяется." />
                    <TextBlock Text="Готовая машина становится образцом: её имя, сеть, домен и прокси попадут в профиль, а через него — в установочный пакет. Windows при этом только читается. Проверьте разделы на вкладке «Профиль» и сохраните." Classes="helperText" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                  <TextBlock Text="Целевая версия Windows" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Укажите, для какой Windows готовится пакет. Совместимость проверяется по этой цели." Classes="noteText" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Редакция" Classes="fieldLabel" />
                        <ComboBox x:Name="DeploymentEditionComboBox" SelectionChanged="DeploymentEdition_SelectionChanged">
                          <ComboBoxItem Tag="Professional">Windows 11 Pro</ComboBoxItem>
                          <ComboBoxItem Tag="Enterprise">Windows 11 Enterprise</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Версия" Classes="fieldLabel" />
                        <ComboBox x:Name="DeploymentVersionComboBox" SelectionChanged="DeploymentVersion_SelectionChanged">
                          <ComboBoxItem Tag="24H2">24H2</ComboBoxItem>
                          <ComboBoxItem Tag="25H2">25H2</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Сборка" Classes="fieldLabel" />
                        <TextBox x:Name="DeploymentBuildTextBox" Text="26100" TextChanged="DeploymentBuild_TextChanged" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
                  <TextBlock Text="Проверка и сборка пакета" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Создаётся только папка с файлами. ISO, USB-накопители, диски и настройки текущей Windows не изменяются." Classes="noteText" />
                    <TextBox x:Name="DeploymentPreviewTextBox" Text="Выберите профиль и целевую версию Windows, затем проверьте совместимость." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" Background="{StaticResource SurfaceSunkenBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="3" /></Border>
                  <TextBlock Text="Установочный USB" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Запись на USB — необратимая операция и открывается в отдельном защищённом окне с подтверждением ERASE." Classes="noteText" />
                    <Button Content="Открыть создание установочного USB…" Click="OpenUsbCreator_Click" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="ApplyTabScrollViewer" Grid.Row="3" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Что сделает выбранный профиль" Classes="cardTitle" />
                    <TextBlock x:Name="PlanSummaryText" Text="Выберите профиль в списке слева." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                  <TextBlock Text="Что будет применено к этому ПК" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Кнопка «Применить к этому ПК» выполняет весь список одним действием, пропускает уже верные настройки и останавливается на первой ошибке. Каждый запуск записывается в локальный журнал." Classes="noteText" />
                    <TextBlock x:Name="ApplyPlanStepsText" Text="Выберите профиль, чтобы увидеть список операций." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <CheckBox x:Name="ApplyTimeZoneCheckBox" Content="Также применить часовой пояс из профиля" IsCheckedChanged="ApplyTimeZoneCheckBox_IsCheckedChanged" />
                    <TextBlock x:Name="TimeZoneActionText" Text="Выберите профиль, чтобы увидеть его часовой пояс." Classes="noteText" />
                    <TextBlock x:Name="ApplyNotAutomatedText" Classes="helperText" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
                  <TextBlock Text="Значения только для текущего запуска" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Заполните только те поля, которые запросит план выше. Сами по себе они в профиль не попадают." Classes="noteText" />
                <Border Classes="innerCard">
                  <StackPanel Spacing="7">
                    <TextBlock Text="ПЕРЕНОС НАСТРОЕК" Classes="quickActionLabel" Foreground="{StaticResource AccentTextBrush}" />
                    <WrapPanel Orientation="Horizontal" ItemHeight="34">
                      <Button Content="↓ Взять из профиля установки" Click="FillRuntimeFromProfile_Click" Classes="ghost" ToolTip.Tip="Подставляет сюда адаптер, прокси, домен и учётную запись, сохранённые в профиле." />
                      <Button Content="↑ Перенести в профиль установки" Click="PushRuntimeToProfile_Click" Classes="ghost" Margin="8,0,0,0" ToolTip.Tip="Записывает введённые здесь имя, адаптер, прокси и домен в профиль, чтобы новая установка Windows повторила эти настройки. Пароль не переносится." />
                      <Button Content="Взять с этого ПК" Click="FillRuntimeFromCurrentPc_Click" Classes="ghost" Margin="8,0,0,0" ToolTip.Tip="Подставляет сюда текущие имя компьютера, активный адаптер, прокси и домен Windows." />
                    </WrapPanel>
                    <TextBlock Text="Профиль общий для обоих режимов, поэтому перенесённые значения увидит и «Подготовить установку Windows». После переноса откройте вкладку «Профиль» и сохраните." Classes="helperText" />
                  </StackPanel>
                </Border>
                <ListBox x:Name="RuntimePromptsList" Height="116" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RuntimePromptListItem}">
                      <StackPanel Margin="8,4" Spacing="2">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Имя компьютера" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeComputerNameTextBox" PlaceholderText="Например, LAB-WS-01" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Имя или GUID сетевого адаптера" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeNetworkAdapterTextBox" PlaceholderText="Точное имя адаптера из Windows" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="Адрес прокси" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeProxyAddressTextBox" PlaceholderText="Только если это запрашивает профиль" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Имя домена" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeDomainNameTextBox" PlaceholderText="Только при присоединении к домену" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="Имя пользователя домена" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeDomainUserNameTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Пароль домена" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeDomainPasswordTextBox" PasswordChar="•" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Пароль и адрес прокси хранятся в памяти только на время проверки или применения. Они никогда не сохраняются в профиле, состоянии resume или журнале." Classes="noteText" />

                <StackPanel x:Name="ManualInstructionsPanel" IsVisible="False" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="3" /></Border>
                    <TextBlock Text="Ручные шаги из профиля" Classes="panelTitle" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Эти шаги Easyaller не выполняет — они описаны в профиле как памятка оператору. Текст никогда не исполняется как команда." Classes="noteText" />
                  <ItemsControl x:Name="ManualInstructionsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <Border Classes="innerCard" Margin="0,0,0,8">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="Результат применения" Classes="cardTitle" Margin="0,8,0,0" />
                <TextBox x:Name="ApplyResultTextBox" Text="Пока ничего не применялось." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" Background="{StaticResource SurfaceSunkenBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="VerifyTabScrollViewer" Grid.Row="3" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Соответствует ли этот компьютер профилю" Classes="cardTitle" />
                    <TextBlock Text="Сверка только читает настройки Windows и ничего не меняет. Пункты, которые профиль не описывает, помечаются как «не задано»." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border x:Name="ComplianceSummaryPanel" IsVisible="False" Classes="innerCard">
                  <StackPanel Spacing="4">
                    <TextBlock x:Name="ComplianceSummaryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ComplianceSummaryDetailText" Classes="helperText" />
                  </StackPanel>
                </Border>

                <ListBox x:Name="ComplianceList" Background="Transparent" BorderThickness="0" MinHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ComplianceCheckListItem}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,6">
                        <Border Width="8" Height="8" CornerRadius="999" VerticalAlignment="Center" Background="{Binding StatusBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="helperText" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="ComplianceEmptyText" Text="Нажмите «Проверить этот компьютер», чтобы сверить его с выбранным профилем." Classes="helperText" Margin="2,0" />
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="4" x:Name="VerifyBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Сверка не меняет Windows. Отчёт сохраняется обычным текстовым файлом и не содержит паролей." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="42" HorizontalAlignment="Left">
                  <Button x:Name="RunComplianceCheckButton" Content="Проверить этот компьютер" Click="RunComplianceCheck_Click" Classes="primary primaryLarge" />
                  <Button x:Name="SaveComplianceReportButton" Content="Сохранить отчёт…" Click="SaveComplianceReport_Click" Classes="ghost" IsEnabled="False" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" x:Name="EditorBottomBar" Classes="bottomBar">
              <StackPanel Spacing="10">
                <WrapPanel Orientation="Horizontal" ItemHeight="46" HorizontalAlignment="Left">
                  <Button Content="Сохранить" Click="SaveProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="primary primaryLarge" ToolTip.Tip="Сохранить все изменения в текущем локальном профиле." />
                  <Button Content="Сбросить" Click="ResetProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="ghost" ToolTip.Tip="Отменить несохранённые изменения и вернуть сохранённую версию профиля." Margin="8,0,0,0" />
                  <Button Content="Создать копию" Click="CloneProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" Classes="ghost" ToolTip.Tip="Создать независимую копию текущего профиля." Margin="8,0,0,0" />
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <CheckBox x:Name="ConfirmDeleteCheckBox" Content="Подтверждаю удаление профиля" IsCheckedChanged="ConfirmDeleteCheckBox_IsCheckedChanged" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                  <Button x:Name="DeleteProfileButton" Grid.Column="1" Content="Удалить профиль" Click="DeleteProfile_Click" Classes="danger" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" x:Name="ApplyBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Проверьте значения, затем введите APPLY, чтобы разрешить применение." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="46" HorizontalAlignment="Left">
                  <Button Content="Проверить значения без изменений" Click="ValidateRuntimeInputs_Click" Classes="ghost" />
                  <TextBox x:Name="ApplyConfirmationTextBox" Width="180" PlaceholderText="После проверки введите APPLY" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <Button x:Name="ApplyRuntimeInputsButton" Content="Применить к этому ПК" Click="ApplyRuntimeInputs_Click" Classes="warningAction primaryLarge" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" x:Name="PrepareBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Шаги выполняются по порядку. Пакет можно сохранить только после безопасного предпросмотра." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="46" HorizontalAlignment="Left">
                  <Button Content="1. Проверить совместимость" Click="PreviewDeployment_Click" Classes="ghost" />
                  <Button Content="2. Безопасный предпросмотр" Click="CreateDryRun_Click" Classes="ghost" Margin="8,0,0,0" />
                  <Button x:Name="ExportDeploymentButton" Content="3. Сохранить пакет в папку" Click="ExportDeploymentPackage_Click" IsEnabled="False" Classes="primary primaryLarge" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="7" Padding="11,7">
          <TextBlock x:Name="StatusText" Text="Готово. Создайте профиль, чтобы начать." FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>
        <Border x:Name="ImportConflictPanel" IsVisible="False" Classes="calloutWarning">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Профиль с таким ID уже существует. Выберите действие." VerticalAlignment="Center" Foreground="{StaticResource WarningTextBrush}" />
            <Button Grid.Column="1" Content="Создать копию" Click="ImportCreateCopy_Click" />
            <Button Grid.Column="2" Content="Заменить" Click="ImportReplace_Click" Classes="warningAction" />
            <Button Grid.Column="3" Content="Отмена" Click="ImportCancel_Click" Classes="ghost" />
          </Grid>
        </Border>
        <Border x:Name="ExportConfirmationPanel" IsVisible="False" Classes="calloutInfo">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ExportWarningText" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="Подтвердить экспорт" Click="ConfirmExport_Click" Classes="primary" />
            <Button Grid.Column="2" Content="Отмена" Click="CancelExport_Click" Classes="ghost" />
          </Grid>
        </Border>
      </StackPanel>
  </Grid>
</Window>
