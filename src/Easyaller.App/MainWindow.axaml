<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="Easyaller"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="720"
        Closing="MainWindow_Closing"
        Background="#101826">
  <Grid ColumnDefinitions="236,*">
    <Border Background="#151E2D" BorderBrush="#27364E" BorderThickness="0,0,1,0" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="easyaller" FontSize="25" FontWeight="SemiBold" Foreground="#F6F8FC" />
          <TextBlock Text="Подготовка Windows" FontSize="12" Foreground="#8EA1C2" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="8">
          <Border Background="#263A5A" CornerRadius="8" Padding="12,10">
            <TextBlock Text="Профили" FontWeight="SemiBold" Foreground="#F6F8FC" />
          </Border>
          <Button Content="Применить профиль" Click="OpenSetup_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" Foreground="#9BAAC3" BorderThickness="0" />
          <TextBlock Text="Там же: подготовка файлов Windows 11" Margin="12,2,12,7" TextWrapping="Wrap" FontSize="12" Foreground="#71839F" />
          <Button Content="Установочный USB" Click="OpenUsbCreator_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" Foreground="#9BAAC3" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="3" Background="#1D2A3E" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Пре-альфа" FontWeight="SemiBold" Foreground="#93C5FD" />
            <TextBlock Text="Профили хранятся локально." TextWrapping="Wrap" FontSize="12" Foreground="#A8B6CC" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="34,28,34,28">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="6">
          <TextBlock Text="Профили" FontSize="30" FontWeight="SemiBold" Foreground="#F7F9FE" />
          <TextBlock Text="Создайте понятный стандарт подготовки компьютера. Пароли и учётные данные не сохраняются." TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left" Foreground="#A9B7CD" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Импорт" Click="ImportProfile_Click" />
          <Button Content="Экспорт" Click="ExportProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" />
          <Button Content="Новый профиль" Click="CreateProfile_Click" Background="#2D6CDF" Foreground="White" Padding="18,10" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="0.82*,1.55*" ColumnSpacing="20">
        <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="20" Padding="14">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" Margin="8,6,8,0">
              <TextBlock Text="Сохранённые профили" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FA" />
              <TextBlock Grid.Column="1" Text="{Binding ProfileListCountText}" FontSize="12" Foreground="#8194B1" VerticalAlignment="Center" />
            </Grid>
            <TextBox x:Name="ProfileSearchTextBox" Grid.Row="1" PlaceholderText="Найти профиль" TextChanged="ProfileSearchTextBox_TextChanged" IsEnabled="{Binding CanSearchProfiles}" Margin="4,0" />
            <Grid Grid.Row="2">
              <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:ProfileListItem}">
                    <Grid ColumnDefinitions="*,Auto" Margin="10,8" ColumnSpacing="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF3FC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="#203653" CornerRadius="999" Padding="8,3" VerticalAlignment="Top">
                        <TextBlock Text="{Binding RevisionLabel}" FontSize="11" Foreground="#A9CCFF" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding HasNoVisibleProfiles}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5" Margin="18">
                <TextBlock Text="Профили не найдены" FontWeight="SemiBold" Foreground="#B7C7E1" HorizontalAlignment="Center" />
                <TextBlock Text="Измените запрос или создайте новый профиль." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="#7F93B4" />
              </StackPanel>
            </Grid>
            <Button Grid.Row="3" Content="Обновить список" Click="Refresh_Click" HorizontalAlignment="Left" Margin="8,2,8,4" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="20" Padding="26">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <TextBlock Text="{Binding SelectedProfileName}" FontSize="22" FontWeight="SemiBold" Foreground="#F7F9FE" />
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <Border Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding SelectedProfileRevision}" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Background="#203653" CornerRadius="999" Padding="10,5" Margin="8,0,0,0"><TextBlock Text="Без учётных данных" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Background="#203653" CornerRadius="999" Padding="10,5" Margin="8,0,0,0"><TextBlock Text="Проверенный формат" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border IsVisible="{Binding HasUnsavedChanges}" Background="#4A3819" BorderBrush="#9A7429" BorderThickness="1" CornerRadius="999" Padding="10,5" Margin="8,0,0,0">
                <TextBlock Text="Есть несохранённые изменения" Foreground="#F6D98A" FontSize="12" FontWeight="SemiBold" />
              </Border>
            </WrapPanel>
            <ScrollViewer x:Name="ProfileEditorScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="0,10,0,0">
              <TextBlock Text="Карточка профиля" FontWeight="SemiBold" Foreground="#EAF0FA" />
              <StackPanel Spacing="6">
                <TextBlock Text="Название" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileNameTextBox" />
                <TextBlock x:Name="ProfileNameErrorText" Classes="validationError" IsVisible="False" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Описание" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileDescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
              </StackPanel>
              <Border Background="#162C42" BorderBrush="#29496B" BorderThickness="1" CornerRadius="14" Padding="14">
                <StackPanel Spacing="5">
                  <TextBlock Text="Краткое резюме" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" />
                  <TextBlock x:Name="ProfileSummaryText" Text="Выберите профиль" TextWrapping="Wrap" Foreground="#E8F1FC" />
                </StackPanel>
              </Border>
              <Border Background="#1D2A3E" CornerRadius="16" Padding="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Как устроена настройка" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <TextBlock Text="Сначала задайте стандарт Windows, затем сеть и доступ, после этого правила первого запуска. Адреса, домен и пароли не нужно хранить в каждом профиле: необходимые значения программа запросит перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#A9B7CD" />
                </StackPanel>
              </Border>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleWindowsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="1. Windows и первый запуск" FontSize="16" FontWeight="SemiBold" />
                      <Border Classes="helpBadge" ToolTip.Tip="Настройки, которые будут использованы при подготовке новой Windows. Они не изменяют уже работающий компьютер.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="sectionStatusBadge">
                      <TextBlock x:Name="WindowsSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="WindowsSectionChevron" Grid.Column="2" Text="⌃" FontSize="18" Foreground="#8FA4C4" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="WindowsSectionContent" IsVisible="True" Background="#1A283B" CornerRadius="14" Margin="0,6,0,0" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="Это стандарт для устанавливаемой Windows. Он не меняет уже работающий компьютер." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Поддерживаемые редакции" FontSize="12" Foreground="#A9B7CD" />
                    <TextBlock Text="Профиль можно применить только к отмеченным редакциям Windows 11." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <CheckBox x:Name="ProfessionalEditionCheckBox" Content="Windows 11 Pro" />
                    <CheckBox x:Name="EnterpriseEditionCheckBox" Content="Windows 11 Enterprise" />
                  </StackPanel>
                  <TextBlock x:Name="WindowsEditionErrorText" Classes="validationError" IsVisible="False" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Язык интерфейса" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="Определяет язык меню, кнопок и основных системных диалогов Windows.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="UiLanguageComboBox">
                        <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                        <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Язык, на котором пользователь видит Windows после установки." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Часовой пояс" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="Задаёт системное время Windows. Выберите зону, в которой будет работать компьютер.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="TimeZoneComboBox">
                        <ComboBoxItem Tag="UTC">UTC (универсальное координированное время)</ComboBoxItem>
                        <ComboBoxItem Tag="West Asia Standard Time">UTC+05:00 (West Asia Standard Time)</ComboBoxItem>
                        <ComboBoxItem Tag="Central Asia Standard Time">UTC+06:00 (Central Asia Standard Time)</ComboBoxItem>
                        <ComboBoxItem Tag="Russian Standard Time">UTC+03:00 (Russian Standard Time)</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Системная зона Windows для часов, расписаний и журналов событий." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Системный язык" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="Определяет язык программ без собственного выбора языка и системных форматов по умолчанию.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="SystemLocaleComboBox">
                        <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                        <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Язык по умолчанию для системных компонентов и программ." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Язык пользователя" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="Определяет региональный язык нового профиля пользователя: даты, числа и другие пользовательские форматы.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="UserLocaleComboBox">
                        <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                        <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Региональный язык для нового профиля пользователя." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                  </Grid>
                  <Border Background="#20324A" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Языки ввода" FontSize="12" FontWeight="SemiBold" Foreground="#DCE8F8" />
                        <Border Classes="helpBadge" ToolTip.Tip="Easyaller всегда добавляет обе раскладки, чтобы после установки можно было переключаться между английским и русским вводом.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="English (en-US) + Русский (ru-RU)" FontWeight="SemiBold" Foreground="#93C5FD" />
                      <TextBlock Text="Обе раскладки сохраняются в профиле автоматически. Ручной ввод кода языка не нужен." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                  </Border>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="OfflineInitialSetupCheckBox" Content="Подготовить автономный первый запуск" />
                      <Border Classes="helpBadge" ToolTip.Tip="Выберите для сценария, где первоначальная настройка Windows должна пройти без обязательного подключения к интернету.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="Скрывает часть экранов, которые требуют интернет или учётную запись. Используйте только для подходящего сценария установки." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Экран подключения к сети" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideWirelessSetupComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Экран онлайн-учётной записи" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideOnlineAccountComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Общие параметры конфиденциальности" FontSize="12" Foreground="#A9B7CD" />
                      <Border Classes="helpBadge" ToolTip.Tip="Единая настройка для поддерживаемых параметров геолокации, рекламы и персонализации. «Не настраивать» сохраняет текущее поведение Windows.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="PrivacyPreferenceComboBox">
                      <ComboBoxItem Tag="retain">Сохранить отдельные параметры</ComboBoxItem>
                      <ComboBoxItem Tag="NotConfigured">Не настраивать все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="UserChoice">Оставить выбор пользователю</ComboBoxItem>
                      <ComboBoxItem Tag="Enabled">Включить все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="Disabled">Отключить все параметры</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Выберите единый режим для служб геолокации, рекламы и персонализации. «Не настраивать» ничего не меняет." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <TextBlock x:Name="WindowsSettingsErrorText" Classes="validationError" IsVisible="False" />
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleNetworkSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="2. Сеть и доступ" FontSize="16" FontWeight="SemiBold" />
                      <Border Classes="helpBadge" ToolTip.Tip="Профиль может хранить статические сетевые параметры и правила WinHTTP-прокси. Адаптер и адрес прокси выбираются перед применением.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="sectionStatusBadge">
                      <TextBlock x:Name="NetworkSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="NetworkSectionChevron" Grid.Column="2" Text="⌄" FontSize="18" Foreground="#8FA4C4" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="NetworkSectionContent" IsVisible="False" Background="#1A283B" CornerRadius="14" Margin="0,6,0,0" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="Выберите, что профиль должен помнить о сети. Сам сетевой адаптер всегда выбирается перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Префикс имени компьютера" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="ComputerNamePrefixTextBox" PlaceholderText="Необязательно, например OFFICE" />
                    <TextBlock x:Name="ComputerNamePrefixErrorText" Classes="validationError" IsVisible="False" />
                    <TextBlock Text="Подсказка для имени. Окончательное имя каждого компьютера вводится перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <Border Background="#1D2A3E" CornerRadius="16" Padding="14">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Сеть" FontWeight="SemiBold" Foreground="#EAF0FA" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Режим сети" FontSize="12" Foreground="#A9B7CD" />
                          <Border Classes="helpBadge" ToolTip.Tip="Ручной режим не хранит адреса. Статический режим сохраняет IPv4, маску, шлюз и DNS в профиле для повторяемой настройки.">
                            <TextBlock Classes="helpBadgeText" Text="!" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="NetworkModeComboBox">
                          <ComboBoxItem Tag="PromptAtRuntime">Выбрать параметры вручную перед применением</ComboBoxItem>
                          <ComboBoxItem Tag="StaticIpv4">Сохранить статический IPv4, шлюз и DNS</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Статический режим сохраняет адреса в профиле. Используйте его только для известных рабочих мест и не публикуйте такой профиль." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="IPv4-адрес" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4AddressTextBox" PlaceholderText="Заполняется только для статической сети" />
                          <TextBlock x:Name="StaticIpv4AddressErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Маска подсети" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4SubnetMaskTextBox" PlaceholderText="Например, 255.255.255.0" />
                          <TextBlock x:Name="StaticIpv4SubnetMaskErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Шлюз по умолчанию" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4DefaultGatewayTextBox" PlaceholderText="Заполняется только для статической сети" />
                          <TextBlock x:Name="StaticIpv4DefaultGatewayErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="DNS-серверы" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4DnsServersTextBox" PlaceholderText="От одного до трёх адресов через запятую" />
                          <TextBlock x:Name="StaticIpv4DnsServersErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Адрес, маска, шлюз и DNS применяются только к выбранному адаптеру после ввода APPLY. Wi-Fi-пароли и VPN-параметры не сохраняются." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                    </StackPanel>
                  </Border>
                  <Border Background="#1D2A3E" CornerRadius="16" Padding="14">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Прокси для системных служб Windows" FontWeight="SemiBold" Foreground="#EAF0FA" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Нужно настраивать прокси?" FontSize="12" Foreground="#A9B7CD" />
                          <Border Classes="helpBadge" ToolTip.Tip="Если выбрать этот вариант, программа запросит адрес прокси только перед применением. Адрес не сохраняется в профиле.">
                            <TextBlock Classes="helpBadgeText" Text="!" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="ProxyModeComboBox">
                          <ComboBoxItem Tag="NotConfigured">Нет, не менять настройки прокси</ComboBoxItem>
                          <ComboBoxItem Tag="PromptAtRuntime">Да, запросить адрес прокси перед применением</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Адрес прокси не сохраняется в профиле. Он запрашивается только для конкретного компьютера." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Исключения для WinHTTP-прокси" FontSize="12" Foreground="#A9B7CD" />
                          <Border Classes="helpBadge" ToolTip.Tip="Адреса и шаблоны из списка открываются без прокси. Настройка применяется только к WinHTTP, а не автоматически ко всем браузерам.">
                            <TextBlock Classes="helpBadgeText" Text="!" />
                          </Border>
                        </StackPanel>
                        <TextBox x:Name="ProxyBypassListTextBox" PlaceholderText="Необязательно: *.example.test, &lt;local&gt;, 192.0.2.53" />
                        <TextBlock x:Name="ProxyBypassListErrorText" Classes="validationError" IsVisible="False" />
                        <TextBlock Text="Адреса и шаблоны, которые должны подключаться без прокси. Введите через запятую. Это работает для WinHTTP, а не автоматически для всех браузеров." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleDomainSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="3. Домен и запуск настройки" FontSize="16" FontWeight="SemiBold" />
                      <Border Classes="helpBadge" ToolTip.Tip="Правила для домена и запуска Easyaller. Пароль домена никогда не сохраняется в профиле.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="sectionStatusBadge">
                      <TextBlock x:Name="DomainSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="DomainSectionChevron" Grid.Column="2" Text="⌄" FontSize="18" Foreground="#8FA4C4" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="DomainSectionContent" IsVisible="False" Background="#1A283B" CornerRadius="14" Margin="0,6,0,0" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="Эти правила определяют, когда Easyaller запускается и требуется ли присоединение к домену. Учётные данные всегда вводятся позднее и не сохраняются." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Присоединение к домену" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="«Не присоединять» ничего не меняет. «Предложить» позволяет пропустить шаг. «Запросить» не позволит применить профиль без данных домена.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="DomainModeComboBox">
                        <ComboBoxItem Tag="NotConfigured">Не присоединять к домену</ComboBoxItem>
                        <ComboBoxItem Tag="Optional">Предложить присоединение при настройке</ComboBoxItem>
                        <ComboBoxItem Tag="Required">Запросить домен перед применением</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Когда запускать Easyaller" FontSize="12" Foreground="#A9B7CD" />
                        <Border Classes="helpBadge" ToolTip.Tip="Ручной запуск оставляет управление оператору. Первый вход открывает Easyaller после первого входа в Windows.">
                          <TextBlock Classes="helpBadgeText" Text="!" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="LaunchModeComboBox">
                        <ComboBoxItem Tag="Manual">Запускать вручную</ComboBoxItem>
                        <ComboBoxItem Tag="FirstLogon">Открыть при первом входе</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Временная учётная запись подготовки" FontSize="12" Foreground="#A9B7CD" />
                      <Border Classes="helpBadge" ToolTip.Tip="После успешной проверки временную учётную запись подготовки можно отключить или удалить. Обычные учётные записи это не затрагивает.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="CleanupModeComboBox">
                      <ComboBoxItem Tag="DisableAfterValidation">Отключить после успешной проверки</ComboBoxItem>
                      <ComboBoxItem Tag="DeleteAfterValidation">Удалить после успешной проверки</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Это правило сработает только после подтверждённой проверки. Оно не удаляет обычные учётные записи пользователя." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel>
                <Button Classes="profileSectionButton" Click="ToggleApplicationsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="4. Приложения и ручные инструкции" FontSize="16" FontWeight="SemiBold" />
                      <Border Classes="helpBadge" ToolTip.Tip="Приложение описывает установку из пакета или ручной источник. Инструкция хранит текст для оператора и никогда не исполняется как команда.">
                        <TextBlock Classes="helpBadgeText" Text="!" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="sectionStatusBadge">
                      <TextBlock x:Name="ApplicationsSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="ApplicationsSectionChevron" Grid.Column="2" Text="⌄" FontSize="18" Foreground="#8FA4C4" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="ApplicationsSectionContent" IsVisible="False" Background="#1A283B" CornerRadius="14" Margin="0,6,0,0" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock Text="Добавляйте только то, что нужно повторять для каждого компьютера. Инструкция описывает ручной шаг и не исполняется как команда." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <TextBlock x:Name="ApplicationsErrorText" Classes="validationError" IsVisible="False" />
                  <TextBlock Text="Приложения" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <ListBox x:Name="ApplicationsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding DisplayName}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID приложения" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationIdTextBox" PlaceholderText="example-app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Отображаемое название" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationDisplayNameTextBox" PlaceholderText="Пример приложения" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Источник" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="ApplicationSourceComboBox">
                        <ComboBoxItem Tag="PackageRelative">Из пакета</ComboBoxItem>
                        <ComboBoxItem Tag="ExternalManual">Внешняя ручная установка</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Путь внутри пакета" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationPathTextBox" PlaceholderText="installers/example.msi" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Аргументы, по одному в строке" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="ApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить приложение" Click="AddApplication_Click" />
                    <Button Content="Удалить выбранное приложение" Click="RemoveApplication_Click" />
                  </StackPanel>
                  <TextBlock Text="Инструкции" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="0,8,0,0" />
                  <ListBox x:Name="InstructionsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding Title}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID инструкции" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionIdTextBox" PlaceholderText="post-install" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Заголовок" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionTitleTextBox" PlaceholderText="После настройки" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Текст инструкции" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="InstructionContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить инструкцию" Click="AddInstruction_Click" />
                    <Button Content="Удалить выбранную инструкцию" Click="RemoveInstruction_Click" />
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <Border Background="#1D2A3E" CornerRadius="16" Padding="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Хранилище" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" FontSize="12" Foreground="#9EB0CC" />
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="3" Background="#1D2A3E" CornerRadius="16" Padding="12">
              <StackPanel Spacing="10">
                <WrapPanel Orientation="Horizontal" ItemHeight="40" HorizontalAlignment="Left">
                  <Button Content="Сохранить" Click="SaveProfile_Click" IsEnabled="{Binding CanSaveProfile}" Background="#2D6CDF" Foreground="White" ToolTip.Tip="Сохранить все изменения в текущем локальном профиле." />
                  <Button Content="Сбросить" Click="ResetProfile_Click" IsEnabled="{Binding CanSaveProfile}" ToolTip.Tip="Отменить несохранённые изменения и вернуть сохранённую версию профиля." Margin="8,0,0,0" />
                  <Button Content="Создать копию" Click="CloneProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" ToolTip.Tip="Создать независимую копию текущего профиля." Margin="8,0,0,0" />
                </WrapPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <CheckBox x:Name="ConfirmDeleteCheckBox" Content="Подтверждаю удаление профиля" IsCheckedChanged="ConfirmDeleteCheckBox_IsCheckedChanged" VerticalAlignment="Center" Foreground="#A9B7CD" />
                  <Button x:Name="DeleteProfileButton" Grid.Column="1" Content="Удалить профиль" Click="DeleteProfile_Click" Background="#7A3340" Foreground="White" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
        <Border Background="#182537" CornerRadius="8" Padding="14">
          <TextBlock x:Name="StatusText" Text="Готово. Создайте профиль, чтобы начать." Foreground="#B7C7E1" />
        </Border>
        <Border x:Name="ImportConflictPanel" IsVisible="False" Background="#3A2D16" BorderBrush="#896A25" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Профиль с таким ID уже существует. Выберите действие." VerticalAlignment="Center" Foreground="#F5DFA0" />
            <Button Grid.Column="1" Content="Создать копию" Click="ImportCreateCopy_Click" />
            <Button Grid.Column="2" Content="Заменить" Click="ImportReplace_Click" Background="#725C22" Foreground="White" />
            <Button Grid.Column="3" Content="Отмена" Click="ImportCancel_Click" />
          </Grid>
        </Border>
        <Border x:Name="ExportConfirmationPanel" IsVisible="False" Background="#1B3140" BorderBrush="#35667E" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ExportWarningText" VerticalAlignment="Center" Foreground="#B9E3F5" />
            <Button Grid.Column="1" Content="Подтвердить экспорт" Click="ConfirmExport_Click" Background="#2D6CDF" Foreground="White" />
            <Button Grid.Column="2" Content="Отмена" Click="CancelExport_Click" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
