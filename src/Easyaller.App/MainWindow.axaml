<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="Easyaller"
        Width="1140"
        Height="740"
        MinWidth="900"
        MinHeight="620"
        Background="#101826">
  <Grid ColumnDefinitions="250,*">
    <Border Background="#151E2D" BorderBrush="#27364E" BorderThickness="0,0,1,0" Padding="20">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="easyaller" FontSize="25" FontWeight="SemiBold" Foreground="#F6F8FC" />
          <TextBlock Text="Подготовка Windows" FontSize="12" Foreground="#8EA1C2" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="8">
          <Border Background="#263A5A" CornerRadius="8" Padding="12,10">
            <TextBlock Text="Профили" FontWeight="SemiBold" Foreground="#F6F8FC" />
          </Border>
          <Button Content="Проверить и применить профиль" Click="OpenSetup_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" Foreground="#9BAAC3" BorderThickness="0" />
          <TextBlock Text="Там же: подготовка файлов Windows 11" Margin="12,2,12,7" TextWrapping="Wrap" FontSize="12" Foreground="#71839F" />
          <Button Content="Создать установочный USB" Click="OpenUsbCreator_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,7" Background="Transparent" Foreground="#9BAAC3" BorderThickness="0" />
        </StackPanel>

        <Border Grid.Row="3" Background="#1D2A3E" CornerRadius="8" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Пре-альфа" FontWeight="SemiBold" Foreground="#93C5FD" />
            <TextBlock Text="Профили хранятся локально." TextWrapping="Wrap" FontSize="12" Foreground="#A8B6CC" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="34,28,34,28">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="6">
          <TextBlock Text="Профили" FontSize="30" FontWeight="SemiBold" Foreground="#F7F9FE" />
          <TextBlock Text="Создайте понятный стандарт подготовки компьютера. Пароли и учётные данные не сохраняются." Foreground="#A9B7CD" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Импорт" Click="ImportProfile_Click" />
          <Button Content="Экспорт" Click="ExportProfile_Click" IsEnabled="{Binding HasSelectedProfile}" />
          <Button Content="Новый профиль" Click="CreateProfile_Click" Background="#2D6CDF" Foreground="White" Padding="18,10" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.35*" ColumnSpacing="20">
        <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="12">
          <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Text="Сохранённые профили" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="8,6,8,12" />
            <ListBox x:Name="ProfilesList" Grid.Row="1" SelectionChanged="ProfilesList_SelectionChanged" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ProfileListItem}">
                  <Border Padding="10" Margin="0,2" CornerRadius="7">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF3FC" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="Обновить список" Click="Refresh_Click" HorizontalAlignment="Left" Margin="8,12,8,4" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="26">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16">
            <TextBlock Text="{Binding SelectedProfileName}" FontSize="22" FontWeight="SemiBold" Foreground="#F7F9FE" />
            <TextBlock Grid.Row="1" Text="{Binding SelectedProfileDescription}" TextWrapping="Wrap" Foreground="#A9B7CD" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
              <Border Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="{Binding SelectedProfileRevision}" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Grid.Column="1" Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="Без учётных данных" Foreground="#A9CCFF" FontSize="12" /></Border>
              <Border Grid.Column="2" Background="#203653" CornerRadius="999" Padding="10,5"><TextBlock Text="Проверенный формат" Foreground="#A9CCFF" FontSize="12" /></Border>
            </Grid>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="0,10,0,0">
              <TextBlock Text="Карточка профиля" FontWeight="SemiBold" Foreground="#EAF0FA" />
              <StackPanel Spacing="6">
                <TextBlock Text="Название" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileNameTextBox" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="Описание" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProfileDescriptionTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
              </StackPanel>
              <Border Background="#1D2A3E" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Как устроена настройка" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <TextBlock Text="Сначала задайте стандарт Windows, затем сеть и доступ, после этого правила первого запуска. Адреса, домен и пароли не нужно хранить в каждом профиле: необходимые значения программа запросит перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#A9B7CD" />
                </StackPanel>
              </Border>
              <Expander Header="1. Windows и первый запуск" IsExpanded="True">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Это стандарт для устанавливаемой Windows. Он не меняет уже работающий компьютер." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Поддерживаемые редакции" FontSize="12" Foreground="#A9B7CD" />
                    <TextBlock Text="Профиль можно применить только к отмеченным редакциям Windows 11." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <CheckBox x:Name="ProfessionalEditionCheckBox" Content="Windows 11 Pro" />
                    <CheckBox x:Name="EnterpriseEditionCheckBox" Content="Windows 11 Enterprise" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Язык интерфейса" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="UiLanguageTextBox" PlaceholderText="en-US" />
                      <TextBlock Text="Язык меню и системных диалогов Windows." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Часовой пояс" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="TimeZoneTextBox" PlaceholderText="UTC" />
                      <TextBlock Text="Системный часовой пояс, например UTC." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Язык ввода" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InputLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Системный язык" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="SystemLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                      <TextBlock Text="Язык пользователя" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="UserLocaleTextBox" PlaceholderText="en-US" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <CheckBox x:Name="OfflineInitialSetupCheckBox" Content="Подготовить автономный первый запуск" />
                    <TextBlock Text="Скрывает часть экранов, которые требуют интернет или учётную запись. Используйте только для подходящего сценария установки." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Экран подключения к сети" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideWirelessSetupComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Экран онлайн-учётной записи" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="HideOnlineAccountComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Общие параметры конфиденциальности" FontSize="12" Foreground="#A9B7CD" />
                    <ComboBox x:Name="PrivacyPreferenceComboBox">
                      <ComboBoxItem Tag="retain">Сохранить отдельные параметры</ComboBoxItem>
                      <ComboBoxItem Tag="NotConfigured">Не настраивать все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="UserChoice">Оставить выбор пользователю</ComboBoxItem>
                      <ComboBoxItem Tag="Enabled">Включить все параметры</ComboBoxItem>
                      <ComboBoxItem Tag="Disabled">Отключить все параметры</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Выберите единый режим для служб геолокации, рекламы и персонализации. «Не настраивать» ничего не меняет." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander Header="2. Сеть и доступ">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Выберите, что профиль должен помнить о сети. Сам сетевой адаптер всегда выбирается перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Префикс имени компьютера" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="ComputerNamePrefixTextBox" PlaceholderText="Необязательно, например OFFICE" />
                    <TextBlock Text="Подсказка для имени. Окончательное имя каждого компьютера вводится перед применением." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                  <Border Background="#1D2A3E" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Сеть" FontWeight="SemiBold" Foreground="#EAF0FA" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Режим сети" FontSize="12" Foreground="#A9B7CD" />
                        <ComboBox x:Name="NetworkModeComboBox">
                          <ComboBoxItem Tag="PromptAtRuntime">Выбрать параметры вручную перед применением</ComboBoxItem>
                          <ComboBoxItem Tag="StaticIpv4">Сохранить статический IPv4, шлюз и DNS</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Статический режим сохраняет адреса в профиле. Используйте его только для известных рабочих мест и не публикуйте такой профиль." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="IPv4-адрес" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4AddressTextBox" PlaceholderText="Заполняется только для статической сети" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Маска подсети" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4SubnetMaskTextBox" PlaceholderText="Например, 255.255.255.0" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Шлюз по умолчанию" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4DefaultGatewayTextBox" PlaceholderText="Заполняется только для статической сети" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="DNS-серверы" FontSize="12" Foreground="#A9B7CD" />
                          <TextBox x:Name="StaticIpv4DnsServersTextBox" PlaceholderText="От одного до трёх адресов через запятую" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Адрес, маска, шлюз и DNS применяются только к выбранному адаптеру после ввода APPLY. Wi-Fi-пароли и VPN-параметры не сохраняются." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                    </StackPanel>
                  </Border>
                  <Border Background="#1D2A3E" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Прокси для системных служб Windows" FontWeight="SemiBold" Foreground="#EAF0FA" />
                      <StackPanel Spacing="6">
                        <TextBlock Text="Нужно настраивать прокси?" FontSize="12" Foreground="#A9B7CD" />
                        <ComboBox x:Name="ProxyModeComboBox">
                          <ComboBoxItem Tag="NotConfigured">Нет, не менять настройки прокси</ComboBoxItem>
                          <ComboBoxItem Tag="PromptAtRuntime">Да, запросить адрес прокси перед применением</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Адрес прокси не сохраняется в профиле. Он запрашивается только для конкретного компьютера." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <TextBlock Text="Исключения для WinHTTP-прокси" FontSize="12" Foreground="#A9B7CD" />
                        <TextBox x:Name="ProxyBypassListTextBox" PlaceholderText="Необязательно: *.example.test, &lt;local&gt;, 192.0.2.53" />
                        <TextBlock Text="Адреса и шаблоны, которые должны подключаться без прокси. Введите через запятую. Это работает для WinHTTP, а не автоматически для всех браузеров." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Expander>
              <Expander Header="3. Домен и запуск настройки">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Эти правила определяют, когда Easyaller запускается и требуется ли присоединение к домену. Учётные данные всегда вводятся позднее и не сохраняются." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Присоединение к домену" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="DomainModeComboBox">
                        <ComboBoxItem Tag="NotConfigured">Не присоединять к домену</ComboBoxItem>
                        <ComboBoxItem Tag="Optional">Предложить присоединение при настройке</ComboBoxItem>
                        <ComboBoxItem Tag="Required">Запросить домен перед применением</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Когда запускать Easyaller" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="LaunchModeComboBox">
                        <ComboBoxItem Tag="Manual">Запускать вручную</ComboBoxItem>
                        <ComboBoxItem Tag="FirstLogon">Открыть при первом входе</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Временная учётная запись подготовки" FontSize="12" Foreground="#A9B7CD" />
                    <ComboBox x:Name="CleanupModeComboBox">
                      <ComboBoxItem Tag="DisableAfterValidation">Отключить после успешной проверки</ComboBoxItem>
                      <ComboBoxItem Tag="DeleteAfterValidation">Удалить после успешной проверки</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Это правило сработает только после подтверждённой проверки. Оно не удаляет обычные учётные записи пользователя." TextWrapping="Wrap" FontSize="12" Foreground="#7F93B4" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Expander Header="4. Приложения и ручные инструкции">
                <StackPanel Margin="0,12,0,0" Spacing="12">
                  <TextBlock Text="Добавляйте только то, что нужно повторять для каждого компьютера. Инструкция описывает ручной шаг и не исполняется как команда." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                  <TextBlock Text="Приложения" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <ListBox x:Name="ApplicationsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding DisplayName}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID приложения" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationIdTextBox" PlaceholderText="example-app" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Отображаемое название" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationDisplayNameTextBox" PlaceholderText="Пример приложения" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Источник" FontSize="12" Foreground="#A9B7CD" />
                      <ComboBox x:Name="ApplicationSourceComboBox">
                        <ComboBoxItem Tag="PackageRelative">Из пакета</ComboBoxItem>
                        <ComboBoxItem Tag="ExternalManual">Внешняя ручная установка</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Путь внутри пакета" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="ApplicationPathTextBox" PlaceholderText="installers/example.msi" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Аргументы, по одному в строке" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="ApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить приложение" Click="AddApplication_Click" />
                    <Button Content="Удалить выбранное приложение" Click="RemoveApplication_Click" />
                  </StackPanel>
                  <TextBlock Text="Инструкции" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="0,8,0,0" />
                  <ListBox x:Name="InstructionsList" Height="96" Background="#1D2A3E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding Title}" Foreground="#EAF0FA" />
                          <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#9EB0CC" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID инструкции" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionIdTextBox" PlaceholderText="post-install" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Заголовок" FontSize="12" Foreground="#A9B7CD" />
                      <TextBox x:Name="InstructionTitleTextBox" PlaceholderText="После настройки" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Текст инструкции" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="InstructionContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить инструкцию" Click="AddInstruction_Click" />
                    <Button Content="Удалить выбранную инструкцию" Click="RemoveInstruction_Click" />
                  </StackPanel>
                </StackPanel>
              </Expander>
              <Button Content="Сохранить изменения" Click="SaveProfile_Click" IsEnabled="{Binding HasSelectedProfile}" HorizontalAlignment="Left" />
              <Border Background="#1D2A3E" CornerRadius="8" Padding="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Хранилище" FontWeight="SemiBold" Foreground="#EAF0FA" />
                  <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" FontSize="12" Foreground="#9EB0CC" />
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
              <Button Content="Клонировать" Click="CloneProfile_Click" IsEnabled="{Binding HasSelectedProfile}" />
              <CheckBox x:Name="ConfirmDeleteCheckBox" Grid.Column="2" Content="Я понимаю, что локальный профиль будет удалён" VerticalAlignment="Center" Foreground="#A9B7CD" />
              <Button Grid.Column="3" Content="Удалить" Click="DeleteProfile_Click" IsEnabled="{Binding HasSelectedProfile}" Background="#5F2631" Foreground="White" />
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
        <Border Background="#182537" CornerRadius="8" Padding="14">
          <TextBlock x:Name="StatusText" Text="Готово. Создайте профиль, чтобы начать." Foreground="#B7C7E1" />
        </Border>
        <Border x:Name="ImportConflictPanel" IsVisible="False" Background="#3A2D16" BorderBrush="#896A25" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Профиль с таким ID уже существует. Выберите действие." VerticalAlignment="Center" Foreground="#F5DFA0" />
            <Button Grid.Column="1" Content="Создать копию" Click="ImportCreateCopy_Click" />
            <Button Grid.Column="2" Content="Заменить" Click="ImportReplace_Click" Background="#725C22" Foreground="White" />
            <Button Grid.Column="3" Content="Отмена" Click="ImportCancel_Click" />
          </Grid>
        </Border>
        <Border x:Name="ExportConfirmationPanel" IsVisible="False" Background="#1B3140" BorderBrush="#35667E" BorderThickness="1" CornerRadius="8" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ExportWarningText" VerticalAlignment="Center" Foreground="#B9E3F5" />
            <Button Grid.Column="1" Content="Подтвердить экспорт" Click="ConfirmExport_Click" Background="#2D6CDF" Foreground="White" />
            <Button Grid.Column="2" Content="Отмена" Click="CancelExport_Click" />
          </Grid>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
