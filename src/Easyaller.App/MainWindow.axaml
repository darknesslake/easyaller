<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Easyaller.App.MainWindow"
        x:DataType="local:MainWindow"
        Title="Easyaller"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="720"
        Closing="MainWindow_Closing"
        Background="{StaticResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18,14">
      <StackPanel Spacing="6" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16" Height="46">
          <Border x:Name="ActiveModeToolbar" Grid.Column="0" Classes="activeModeToolbar" HorizontalAlignment="Left" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <materialIcons:MaterialIcon x:Name="ActiveModeIcon" Kind="Monitor" Width="18" Height="18" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock x:Name="ActiveModeTitleText" Text="Настроить этот компьютер" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="2,2" />
              <Button x:Name="ExitModeButton" Classes="ghost" Click="ExitMode_Click" Padding="10,6" ToolTip.Tip="Вернуться к выбору режима">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <materialIcons:MaterialIcon Kind="ArrowLeft" Width="17" Height="17" />
                  <TextBlock Text="Выйти из режима" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <TextBlock Grid.Column="1" Text="EASYALLER" Classes="pageTitle" VerticalAlignment="Center" HorizontalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Border Classes="tag" VerticalAlignment="Center" ToolTip.Tip="Профили хранятся локально на этом компьютере.">
              <TextBlock Text="Пре-альфа" Classes="tagText" />
            </Border>
            <Button IsVisible="{Binding IsMissingAdministratorRights}" Click="RestartElevated_Click" Classes="warningAction" Padding="9,4" VerticalAlignment="Center"
                    ToolTip.Tip="Переименование компьютера, присоединение к домену, настройка сети и большинство установщиков требуют прав администратора. Без них эти шаги остановятся с ошибкой, а установщики будут запрашивать подтверждение по одному.">
              <TextBlock Text="Без прав администратора — перезапустить" FontSize="11" FontWeight="SemiBold" />
            </Button>
            <Button Click="OpenDocumentation_Click" Classes="ghost" Width="36" Height="34"
                    ToolTip.Tip="Справка — открыть встроенное руководство без интернета">
              <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="19" Height="19" />
            </Button>
          </StackPanel>

        </Grid>
      </StackPanel>

      <Border x:Name="ModeSelectionWorkspace" Grid.Row="1" Classes="modeSelectionSurface">
        <StackPanel Width="860" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
          <StackPanel Spacing="7" HorizontalAlignment="Center">
            <TextBlock Text="Что вы хотите сделать?" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Сначала выберите профиль, затем режим работы. В любой момент можно вернуться сюда." Classes="pageSubtitle" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <Border Classes="innerCard" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Профиль для работы" Classes="fieldLabel" />
                  <ComboBox x:Name="MainMenuProfileComboBox" MinWidth="420" SelectionChanged="MainMenuProfileComboBox_SelectionChanged" PlaceholderText="Выберите профиль">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ProfileListItem}">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Classes="helperText" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                    <Button Content="Новый профиль" Click="CreateProfile_Click" Classes="ghost" />
                    <Button Content="Импорт…" Click="ImportProfile_Click" Classes="ghost" />
                    <Button Content="Экспорт" Click="ExportProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" Classes="ghost" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                    <Button Content="Создать копию" Click="CloneProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" Classes="ghost" />
                    <Button Content="Удалить…" Click="DeleteProfile_Click" IsEnabled="{Binding CanUseSavedProfileActions}" Classes="ghost" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="5">
                  <TextBlock Text="Название" Classes="fieldLabel" />
                  <TextBox x:Name="MainMenuProfileNameTextBox" PlaceholderText="Название профиля" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="Описание" Classes="fieldLabel" />
                  <TextBox x:Name="MainMenuProfileDescriptionTextBox" PlaceholderText="Кратко опишите назначение профиля" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Bottom">
                  <Button Content="Сбросить" Click="ResetProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="ghost" />
                  <Button Content="Сохранить" Click="SaveMainMenuProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="primary" />
                </StackPanel>
              </Grid>
              <TextBlock x:Name="MainMenuProfileErrorText" Classes="validationError" IsVisible="False" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Button x:Name="ThisPcModeButton" Grid.Column="0" Classes="modeChoice" Click="SelectThisPcMode_Click">
              <StackPanel Spacing="13">
                <Border Classes="modeChoiceIcon navIconBlue">
                  <materialIcons:MaterialIcon Kind="Monitor" Width="27" Height="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Настроить этот компьютер" Classes="modeChoiceTitle" />
                <TextBlock Text="Применить профиль и параметры к уже установленной Windows." Classes="modeChoiceDescription" />
                <TextBlock Text="Открыть режим" Classes="modeChoiceAction" />
              </StackPanel>
            </Button>

            <Button x:Name="MaintenanceModeButton" Grid.Column="1" Classes="modeChoice" Click="SelectMaintenanceMode_Click">
              <StackPanel Spacing="13">
                <Border Classes="modeChoiceIcon navIconPurple">
                  <materialIcons:MaterialIcon Kind="Cog" Width="27" Height="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Обслуживание ПК" Classes="modeChoiceTitle" />
                <TextBlock Text="Скопировать ярлыки пользователю или архивировать письма Outlook." Classes="modeChoiceDescription" />
                <TextBlock Text="Открыть режим" Classes="modeChoiceAction" />
              </StackPanel>
            </Button>

            <Button x:Name="NewInstallModeButton" Grid.Column="2" Classes="modeChoice" Click="SelectNewInstallMode_Click">
              <StackPanel Spacing="13">
                <Border Classes="modeChoiceIcon navIconOrange">
                  <materialIcons:MaterialIcon Kind="UsbFlashDrive" Width="27" Height="27" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="New USB Install" Classes="modeChoiceTitle" />
                <TextBlock Text="Подготовить профиль и файлы для новой установки Windows." Classes="modeChoiceDescription" />
                <TextBlock Text="Открыть режим" Classes="modeChoiceAction" />
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock Text="Выбор не изменяет компьютер и не запускает установку." Classes="helperText" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <Grid x:Name="ProfileWorkspaceGrid" Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="14" IsVisible="False">
        <Border Classes="settingsSidebar" Padding="10">
          <Grid RowDefinitions="*,Auto" RowSpacing="7">
            <StackPanel x:Name="SettingsNavigationPanel" Grid.Row="0" Spacing="3">
              <TextBlock Text="РАЗДЕЛЫ" Classes="quickActionLabel" Margin="8,0,0,4" />
              <Button x:Name="WindowsSettingsNavButton" Classes="navItem active" Click="SelectWindowsSettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconBlue"><materialIcons:MaterialIcon Kind="Monitor" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Windows" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="NetworkSettingsNavButton" Classes="navItem" Click="SelectNetworkSettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconCyan"><materialIcons:MaterialIcon Kind="Lan" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Сеть и доступ" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="DomainSettingsNavButton" Classes="navItem" Click="SelectDomainSettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconPurple"><materialIcons:MaterialIcon Kind="Domain" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Домен" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Border Height="1" Background="{StaticResource BorderBrush1}" Margin="2,6" />
              <Button x:Name="ApplySettingsNavButton" Classes="navItem" Click="SelectApplySettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconOrange"><materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Применить настройки" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="VerifySettingsNavButton" Classes="navItem" Click="SelectVerifySettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconGreen"><materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Проверить результат" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="SoftwareSettingsNavButton" Classes="navItem" Click="SelectSoftwareSettingsSection_Click">
                <StackPanel Orientation="Horizontal"><Border Classes="navIcon navIconGray"><materialIcons:MaterialIcon Kind="ViewGridOutline" Width="16" Height="16" Foreground="White" /></Border><TextBlock Text="Установка программ" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Row="1" Content="Обновить профиль" Click="Refresh_Click" Classes="ghost" HorizontalAlignment="Stretch" Padding="8,5" />
            <Panel IsVisible="False">
              <TextBox x:Name="ProfileSearchTextBox" TextChanged="ProfileSearchTextBox_TextChanged" />
              <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged" />
            </Panel>
          </Grid>
        </Border>

        <Border x:Name="ProfileEditorWorkspace" Grid.Column="1" Classes="contentPane" Padding="14,4,2,2">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="11">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <Panel VerticalAlignment="Center" HorizontalAlignment="Left">
                  <TextBlock x:Name="ProfileNameDisplayText" Text="{Binding SelectedProfileName}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBox x:Name="ProfileNameTextBox" IsVisible="False" FontSize="15.5" FontWeight="SemiBold" Padding="4,2" MinWidth="240" LostFocus="ProfileNameTextBox_LostFocus" KeyDown="ProfileNameTextBox_KeyDown" />
                </Panel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Взять с этого ПК" Click="TakeEverythingFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает имя, сеть, домен и прокси текущей Windows и записывает их в профиль одним действием. Windows не изменяется." />
                  <Button Content="Сбросить" Click="ResetProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="ghost" ToolTip.Tip="Отменяет несохранённые правки и возвращает форму к сохранённой версии профиля." />
                  <Button Content="Сохранить" Click="SaveProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="primary" ToolTip.Tip="Сохранить все изменения в текущем локальном профиле." />
                  <Border IsVisible="{Binding HasUnsavedChanges}" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="Не сохранено" Foreground="{StaticResource WarningTextBrush}" FontSize="10.5" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="ProfileNameErrorText" Classes="validationError" IsVisible="False" />
              <Panel HorizontalAlignment="Stretch">
                <TextBlock x:Name="ProfileDescriptionDisplayText" Classes="helperText" TextWrapping="Wrap" />
                <TextBox x:Name="ProfileDescriptionTextBox" IsVisible="False" FontSize="12" Padding="8,5" PlaceholderText="Описание профиля (необязательно)" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" LostFocus="ProfileDescriptionTextBox_LostFocus" KeyDown="ProfileDescriptionTextBox_KeyDown" />
              </Panel>
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <Border Classes="tag"><TextBlock Text="{Binding SelectedProfileRevision}" Classes="tagText" /></Border>
              <Border Classes="tag" Margin="6,0,0,0" ToolTip.Tip="Профиль не хранит пароли и токены. Имя доменной учётной записи, домен, адреса сети и прокси в нём сохраняются — это конфиденциальные данные, проверяйте их перед передачей профиля."><TextBlock Text="Без паролей" Classes="tagText" /></Border>
            </WrapPanel>
            <Grid x:Name="TabSwitcherPanel" Grid.Row="2" ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="EditTabButton" Classes="tabPill active" Content="Профиль" Click="ShowEditTab_Click" />
                <Button x:Name="ApplyTabButton" Classes="tabPill" Content="Применить на этом ПК" Click="ShowApplyTab_Click" />
                <Button x:Name="VerifyTabButton" Classes="tabPill" Content="Проверка" Click="ShowVerifyTab_Click" ToolTip.Tip="Сверяет текущую Windows с профилем. Только чтение, ничего не меняет." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Как заполнить профиль?" Click="OpenProfileDocumentation_Click" Classes="ghost" />
                <Button Content="Как применить?" Click="OpenApplyDocumentation_Click" Classes="ghost" />
              </StackPanel>
            </Grid>
            <ScrollViewer x:Name="UnifiedThisPcScrollViewer" Grid.Row="3" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="16">
                <Border x:Name="UnifiedProfileHeader" Classes="calloutInfo" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock Text="1. Профиль и стандарт компьютера" Classes="panelTitle" />
                    <TextBlock Text="Значения сохраняются в выбранном профиле. Само редактирование ничего на этом ПК не меняет." Classes="helperText" />
                  </StackPanel>
                </Border>
            <ScrollViewer x:Name="ProfileEditorScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="9" Margin="0,6,0,0">
              <TextBlock x:Name="ProfileSummaryText" Text="Выберите профиль" Classes="helperText" Margin="2,0" />
              <StackPanel x:Name="WindowsProfileSection">
                <Button Classes="profileSectionButton" Click="ToggleWindowsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><materialIcons:MaterialIcon Kind="ClockOutline" Width="17" Height="17" Foreground="White" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock x:Name="WindowsSectionTitleText" Text="Windows и первый запуск" Classes="pageTitle" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Настройки, которые будут использованы при подготовке новой Windows. Они не изменяют уже работающий компьютер.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="WindowsSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="WindowsSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="WindowsSectionContent" IsVisible="False" Classes="settingsGroup">
                <StackPanel Spacing="12">
                  <TextBlock x:Name="WindowsSectionNoteText" Text="Это стандарт для устанавливаемой Windows. Он не меняет уже работающий компьютер." Classes="noteText" />
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Часовой пояс" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Задаёт системное время Windows. Единственная настройка этого раздела, которую можно применить к уже установленной Windows.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="TimeZoneComboBox" HorizontalAlignment="Left" MinWidth="320">
                      <ComboBoxItem Tag="UTC">UTC (универсальное координированное время)</ComboBoxItem>
                      <ComboBoxItem Tag="West Asia Standard Time">UTC+05:00 (West Asia Standard Time)</ComboBoxItem>
                      <ComboBoxItem Tag="Central Asia Standard Time">UTC+06:00 (Central Asia Standard Time)</ComboBoxItem>
                      <ComboBoxItem Tag="Russian Standard Time">UTC+03:00 (Russian Standard Time)</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                  <Border Classes="quickActionOnPc">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                      <Button x:Name="ApplyTimeZoneToCurrentPcButton" Content="Применить часовой пояс на этом ПК" HorizontalAlignment="Left" Click="ApplyTimeZoneToCurrentPc_Click" Classes="warningAction" ToolTip.Tip="Меняет только часовой пояс прямо сейчас. Кнопка «Сохранить» внизу страницы сохраняет лишь профиль и не трогает этот компьютер." />
                    </StackPanel>
                  </Border>

                  <StackPanel x:Name="InstallOnlyWindowsSettings" Spacing="12">
                    <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="10,7">
                      <TextBlock Text="Ниже — параметры файла ответов Windows Setup. Они действуют только при установке новой Windows и на этот компьютер не влияют." Classes="helperText" />
                    </Border>
                    <StackPanel Spacing="6">
                      <TextBlock Text="Поддерживаемые редакции" Classes="fieldLabel" />
                      <TextBlock Text="Профиль можно применить только к отмеченным редакциям Windows 11." Classes="helperText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="18">
                      <CheckBox x:Name="ProfessionalEditionCheckBox" Content="Windows 11 Pro" />
                      <CheckBox x:Name="EnterpriseEditionCheckBox" Content="Windows 11 Enterprise" />
                    </StackPanel>
                    <TextBlock x:Name="WindowsEditionErrorText" Classes="validationError" IsVisible="False" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Язык интерфейса" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Определяет язык меню, кнопок и основных системных диалогов Windows.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="UiLanguageComboBox">
                          <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                          <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Системный язык" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Язык программ без собственного выбора языка и системных форматов по умолчанию.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="SystemLocaleComboBox">
                          <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                          <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6" HorizontalAlignment="Left" MinWidth="320">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Язык пользователя" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="Региональный язык нового профиля пользователя: даты, числа и другие форматы.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="UserLocaleComboBox">
                        <ComboBoxItem Tag="en-US">English (en-US)</ComboBoxItem>
                        <ComboBoxItem Tag="ru-RU">Русский (ru-RU)</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Языки ввода" Classes="fieldLabel" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Classes="helpBadge" ToolTip.Tip="Easyaller всегда добавляет обе раскладки, чтобы после установки можно было переключаться между английским и русским вводом.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="English (en-US) + Русский (ru-RU)" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="OfflineInitialSetupCheckBox" Content="Подготовить автономный первый запуск" />
                    <Border Classes="helpBadge" ToolTip.Tip="Скрывает экраны, которые требуют интернет или учётную запись. Используйте только для подходящего сценария установки.">
                      <TextBlock Classes="helpBadgeText" Text="i" />
                    </Border>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Экран подключения к сети" Classes="fieldLabel" />
                      <ComboBox x:Name="HideWirelessSetupComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Экран онлайн-учётной записи" Classes="fieldLabel" />
                      <ComboBox x:Name="HideOnlineAccountComboBox">
                        <ComboBoxItem Tag="unset">Не настроено</ComboBoxItem>
                        <ComboBoxItem Tag="true">Скрыть</ComboBoxItem>
                        <ComboBoxItem Tag="false">Показать</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Общие параметры конфиденциальности" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Записывается во все семь параметров профиля, но реально применяются только три: геолокация, рекламный ID и распознавание речи — для остальных у Microsoft нет документированной политики. «Разрешить» включает только геолокацию.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="PrivacyPreferenceComboBox">
                      <ComboBoxItem Tag="retain">Не менять — как задано в профиле</ComboBoxItem>
                      <ComboBoxItem Tag="NotConfigured">Не настраивать — ничего не применяется</ComboBoxItem>
                      <ComboBoxItem Tag="UserChoice">Выбор пользователя — ничего не применяется</ComboBoxItem>
                      <ComboBoxItem Tag="Enabled">Разрешить — применится только геолокация</ComboBoxItem>
                      <ComboBoxItem Tag="Disabled">Запретить — геолокация, реклама, распознавание речи</ComboBoxItem>
                    </ComboBox>
                    <Border Classes="quickActionOnPc">
                      <StackPanel Spacing="6">
                        <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                        <Button x:Name="ApplyPrivacyToCurrentPcButton" Content="Применить конфиденциальность на этом ПК" HorizontalAlignment="Left" Click="ApplyPrivacyToCurrentPc_Click" Classes="warningAction" ToolTip.Tip="Нужны права администратора и Windows 11 Pro/Enterprise 26100+. «Не настраивать» и «Выбор пользователя» ничего не применяют." />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="WindowsSettingsErrorText" Classes="validationError" IsVisible="False" />
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="NetworkProfileSection" IsVisible="False">
                <Button Classes="profileSectionButton" Click="ToggleNetworkSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><materialIcons:MaterialIcon Kind="Lan" Width="17" Height="17" Foreground="White" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="Сеть и доступ" Classes="pageTitle" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Профиль может хранить статические сетевые параметры и правила прокси. Адаптер и адрес прокси выбираются перед применением.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="NetworkSectionStatusText" Text="Готово" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="NetworkSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="NetworkSectionContent" IsVisible="False" Classes="settingsGroup">
                <StackPanel Spacing="12">
                  <TextBlock Text="Имя компьютера, адреса сети и прокси. Адаптер профиль хранит только как подсказку — перед применением его нужно подтвердить." Classes="noteText" />
                  <StackPanel Spacing="6">
                    <TextBlock Text="Шаблон имени компьютера" Classes="fieldLabel" />
                    <TextBlock Text="Начало имени: URA01" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox x:Name="ComputerNameTypeComboBox">
                      <ComboBoxItem Tag="NOMAD">NOMAD</ComboBoxItem>
                      <ComboBoxItem Tag="THINK">THINK</ComboBoxItem>
                      <ComboBoxItem Tag="Custom">Свой вариант</ComboBoxItem>
                    </ComboBox>
                    <TextBox x:Name="ComputerNameCustomTypeTextBox" PlaceholderText="Свой тип, только буквы и цифры" />
                    <TextBlock x:Name="ComputerNamePrefixErrorText" Classes="validationError" IsVisible="False" />
                    <TextBlock Text="Номер конкретного ПК в профиль не попадает — задаётся при применении." Classes="helperText" />
                    <Border Classes="quickActionOnPc">
                      <StackPanel Spacing="6">
                        <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                        <TextBox x:Name="ComputerNameNumberTextBox" PlaceholderText="Номер этого ПК: 2 или 3 цифры" HorizontalAlignment="Left" MinWidth="260" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Content="Взять имя с этого ПК" Click="TakeComputerNameFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Разбирает текущее имя компьютера на шаблон профиля и номер. Windows не изменяется." />
                          <Button x:Name="ApplyComputerNameToCurrentPcButton" Content="Применить имя на этом ПК" Click="ApplyComputerNameToCurrentPc_Click" Classes="warningAction" />
                        </StackPanel>
                        <TextBlock x:Name="ComputerNamePreviewText" Classes="helperText" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Сеть" Classes="cardTitle" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Режим сети" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Ручной режим не хранит адреса. Статический режим сохраняет IPv4, маску и шлюз в профиле для повторяемой настройки; DNS-серверы можно добавить, но они необязательны.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="NetworkModeComboBox">
                          <ComboBoxItem Tag="PromptAtRuntime">Выбрать параметры вручную перед применением</ComboBoxItem>
                          <ComboBoxItem Tag="StaticIpv4">Сохранить статический IPv4, маску и шлюз (DNS — по желанию)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Статический режим сохраняет адреса в профиле. Используйте его только для известных рабочих мест и не публикуйте такой профиль." Classes="helperText" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="IPv4-адрес" Classes="fieldLabel" />
                          <TextBox x:Name="StaticIpv4AddressTextBox" PlaceholderText="Заполняется только для статической сети" />
                          <TextBlock x:Name="StaticIpv4AddressErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Маска подсети" Classes="fieldLabel" />
                          <TextBox x:Name="StaticIpv4SubnetMaskTextBox" PlaceholderText="Например, 255.255.255.0" />
                          <TextBlock x:Name="StaticIpv4SubnetMaskErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Шлюз по умолчанию" Classes="fieldLabel" />
                            <Border Classes="tag" Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="Необязательно" Classes="tagText" />
                            </Border>
                            <Border Classes="helpBadge" ToolTip.Tip="Оставьте пустым для изолированной подсети без выхода наружу. Если шлюз задан, он должен быть в той же подсети, что и адрес.">
                              <TextBlock Classes="helpBadgeText" Text="i" />
                            </Border>
                          </StackPanel>
                          <TextBox x:Name="StaticIpv4DefaultGatewayTextBox" PlaceholderText="Пусто — сеть без выхода наружу" />
                          <TextBlock x:Name="StaticIpv4DefaultGatewayErrorText" Classes="validationError" IsVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Сетевой адаптер" Classes="fieldLabel" />
                            <Border Classes="tag"><TextBlock Text="Подсказка" Classes="tagText" /></Border>
                            <Border Classes="helpBadge" ToolTip.Tip="Своё на каждом ПК, поэтому не применяется автоматически — только подставляется в поле адаптера перед применением, где нужно подтвердить. По умолчанию Ethernet.">
                              <TextBlock Classes="helpBadgeText" Text="i" />
                            </Border>
                          </StackPanel>
                          <TextBox x:Name="StaticIpv4AdapterIdTextBox" PlaceholderText="Ethernet" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="DNS-серверы" Classes="fieldLabel" />
                          <Border Classes="tag" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Необязательно" Classes="tagText" />
                          </Border>
                          <Border Classes="helpBadge" ToolTip.Tip="До трёх адресов, без повторов. Если список пуст, DNS-серверы адаптера остаются без изменений — адрес, маска и шлюз всё равно применяются.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <Grid>
                          <ListBox x:Name="DnsServersList" Classes="compactList" MinHeight="56" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="DnsServersList_SelectionChanged" />
                          <TextBlock IsVisible="{Binding HasNoDnsServers}" IsHitTestVisible="False" Text="DNS не задан — текущие DNS-серверы адаптера не изменятся" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" Classes="helperText" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBox x:Name="DnsServerInputTextBox" PlaceholderText="Например, 10.0.0.1" KeyDown="DnsServerInputTextBox_KeyDown" />
                          <Button Grid.Column="1" x:Name="AddDnsServerButton" Content="+ Добавить" Click="AddDnsServer_Click" />
                          <Button Grid.Column="2" x:Name="RemoveDnsServerButton" Content="Удалить" Classes="ghost" Click="RemoveDnsServer_Click" />
                        </Grid>
                        <TextBlock x:Name="StaticIpv4DnsServersErrorText" Classes="validationError" IsVisible="False" />
                        <TextBlock Text="Нажмите «+ Добавить» или Enter, чтобы внести адрес." Classes="helperText" />
                      </StackPanel>
                      <Border Classes="quickActionOnPc">
                        <StackPanel Spacing="6">
                          <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Взять сеть с этого ПК" Click="TakeNetworkFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает текущие адрес, маску, шлюз и DNS активного адаптера и подставляет их в профиль. Windows не изменяется." />
                            <Button x:Name="ApplyStaticIpv4ToCurrentPcButton" Content="Применить сеть на этом ПК" Click="ApplyStaticIpv4ToCurrentPc_Click" Classes="warningAction" ToolTip.Tip="Меняет адрес и маску выбранного адаптера прямо сейчас; шлюз и DNS — лишь если заданы выше." />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Classes="innerCard">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Прокси для системных служб Windows" Classes="cardTitle" />
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Режим прокси" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Применяется сразу в двух местах: прокси браузера и приложений (Параметры → Сеть → Прокси) и отдельный WinHTTP-прокси для служб вроде Windows Update. Не сохраняется в профиле — запрашивается при применении.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <ComboBox x:Name="ProxyModeComboBox">
                          <ComboBoxItem Tag="NotConfigured">Не настраивать</ComboBoxItem>
                          <ComboBoxItem Tag="PromptAtRuntime">Запросить адрес перед применением</ComboBoxItem>
                        </ComboBox>
                        <TextBox x:Name="ProxyAddressTextBox" PlaceholderText="Адрес прокси, например proxy.example.test:8080" />
                        <Border Classes="quickActionOnPc">
                          <StackPanel Spacing="6">
                            <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="Взять прокси с этого ПК" Click="TakeProxyFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает прокси браузера и приложений вместе со списком исключений. Windows не изменяется." />
                              <Button x:Name="ApplyProxyToCurrentPcButton" Content="Применить прокси на этом ПК" Click="ApplyProxyToCurrentPc_Click" Classes="warningAction" ToolTip.Tip="Меняет прокси браузера и WinHTTP-прокси служб на этом ПК прямо сейчас." />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Исключения прокси" Classes="fieldLabel" />
                          <Border Classes="helpBadge" ToolTip.Tip="Адреса и шаблоны через запятую, которые открываются без прокси. Применяется и к браузерному, и к WinHTTP-прокси.">
                            <TextBlock Classes="helpBadgeText" Text="i" />
                          </Border>
                        </StackPanel>
                        <TextBox x:Name="ProxyBypassListTextBox" PlaceholderText="Необязательно: *.example.test, &lt;local&gt;, 192.0.2.53" />
                        <TextBlock x:Name="ProxyBypassListErrorText" Classes="validationError" IsVisible="False" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="DomainProfileSection" IsVisible="False">
                <Button Classes="profileSectionButton" Click="ToggleDomainSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><materialIcons:MaterialIcon Kind="Domain" Width="17" Height="17" Foreground="White" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock x:Name="DomainSectionTitleText" Text="Домен и запуск настройки" Classes="pageTitle" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Правила для домена и запуска Easyaller. Пароль домена никогда не сохраняется в профиле.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="DomainSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="DomainSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="DomainSectionContent" IsVisible="False" Classes="settingsGroup">
                <StackPanel Spacing="12">
                  <TextBlock x:Name="DomainSectionNoteText" Text="Эти правила определяют, когда Easyaller запускается и требуется ли присоединение к домену. Пароль всегда вводится позднее и не сохраняется." Classes="noteText" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Присоединение к домену" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="«Не присоединять» ничего не меняет. «Предложить» позволяет пропустить шаг. «Запросить» не позволит применить профиль без данных домена.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="DomainModeComboBox">
                        <ComboBoxItem Tag="NotConfigured">Не присоединять к домену</ComboBoxItem>
                        <ComboBoxItem Tag="Optional">Предложить присоединение при настройке</ComboBoxItem>
                        <ComboBoxItem Tag="Required">Запросить домен перед применением</ComboBoxItem>
                      </ComboBox>
                      <TextBox x:Name="DomainNameTextBox" PlaceholderText="Домен, например contoso.local" />
                      <TextBox x:Name="DomainUserNameTextBox" PlaceholderText="Учётная запись домена" />
                    </StackPanel>
                    <StackPanel x:Name="InstallOnlyLaunchSettings" Grid.Column="1" Spacing="6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Когда запускать Easyaller" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="Относится только к устанавливаемой Windows: ручной запуск оставляет управление оператору, «первый вход» открывает Easyaller после первого входа.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="LaunchModeComboBox">
                        <ComboBoxItem Tag="Manual">Запускать вручную</ComboBoxItem>
                        <ComboBoxItem Tag="FirstLogon">Открыть при первом входе</ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <Border Classes="quickActionOnPc">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                      <TextBox x:Name="DomainPasswordTextBox" PasswordChar="•" PlaceholderText="Пароль домена — только для этого действия, не сохраняется" HorizontalAlignment="Left" MinWidth="360" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Взять домен с этого ПК" Click="TakeDomainFromCurrentPc_Click" Classes="ghost" ToolTip.Tip="Читает домен, в котором состоит этот компьютер. Учётные данные не читаются и не сохраняются." />
                        <Button x:Name="ApplyDomainToCurrentPcButton" Content="Присоединить к домену на этом ПК" Click="ApplyDomainToCurrentPc_Click" Classes="warningAction" ToolTip.Tip="Присоединяет этот компьютер к домену прямо сейчас и может потребовать перезагрузку. Пароль используется только для этой операции и не сохраняется." />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <StackPanel x:Name="InstallOnlyCleanupSettings" Spacing="6">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Временная учётная запись подготовки" Classes="fieldLabel" />
                      <Border Classes="helpBadge" ToolTip.Tip="Только для новой установки: после успешной проверки временную учётную запись можно отключить или удалить. Обычные учётные записи это не затрагивает.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <ComboBox x:Name="CleanupModeComboBox">
                      <ComboBoxItem Tag="DisableAfterValidation">Отключить после успешной проверки</ComboBoxItem>
                      <ComboBoxItem Tag="DeleteAfterValidation">Удалить после успешной проверки</ComboBoxItem>
                    </ComboBox>
                    <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="10,7">
                      <TextBlock Text="Сохраняется в профиле, но пока ни на что не влияет: создание временной учётной записи подготовки в этой сборке не включается." TextWrapping="Wrap" Classes="helperText" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="ApplicationsProfileSection" IsVisible="False">
                <Button Classes="profileSectionButton" Click="ToggleApplicationsSection_Click" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="4" /></Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock Text="Приложения и ручные инструкции" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Classes="helpBadge" ToolTip.Tip="Приложение описывает установку из пакета или ручной источник. Инструкция хранит текст для оператора и никогда не исполняется как команда.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="sectionStatusBadge">
                      <TextBlock x:Name="ApplicationsSectionStatusText" Text="Необязательно" Classes="sectionStatusText" />
                    </Border>
                    <TextBlock x:Name="ApplicationsSectionChevron" Grid.Column="3" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Border x:Name="ApplicationsSectionContent" IsVisible="False" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="11">
                <StackPanel Spacing="12">
                  <TextBlock Text="Добавляйте только то, что нужно повторять для каждого компьютера. Инструкция описывает ручной шаг и не исполняется как команда." Classes="noteText" />
                  <TextBlock x:Name="ApplicationsErrorText" Classes="validationError" IsVisible="False" />
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Папка с установщиками" Classes="fieldLabel" />
                      <Border Classes="tag"><TextBlock Text="Заполняется само" Classes="tagText" /></Border>
                      <Border Classes="helpBadge" ToolTip.Tip="Откуда брать установщики: сетевая шара или локальная папка. Обычно её не нужно вводить — она подставляется, когда вы добавляете файлы кнопкой ниже. Пути приложений отсчитываются от неё.">
                        <TextBlock Classes="helpBadgeText" Text="i" />
                      </Border>
                    </StackPanel>
                    <TextBox x:Name="ApplicationSourcePathTextBox" PlaceholderText="\\server\share\installers или D:\installers" />
                    <TextBlock x:Name="ApplicationSourcePathErrorText" Classes="validationError" IsVisible="False" />
                    <TextBlock Text="Сохраняется в профиле и показывается при экспорте как конфиденциальное значение — оно раскрывает имя внутреннего сервера." Classes="helperText" />
                  </StackPanel>
                  <TextBlock Text="Приложения" Classes="cardTitle" />
                  <TextBlock Text="Дважды щёлкните по названию программы, чтобы установить только её на этот ПК." Classes="helperText" />
                  <ListBox x:Name="ApplicationsList" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" SelectionChanged="ApplicationsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="6,3">
                          <Border Classes="stepBadge" MinWidth="24" Padding="6,2">
                            <TextBlock Text="{Binding QueueNumber}" Classes="stepBadgeText" HorizontalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" DoubleTapped="ApplicationItem_DoubleTapped" Cursor="Hand" ToolTip.Tip="Двойной щелчок — установить только эту программу на текущий ПК">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Content="↑" Click="MoveApplicationItemUp_Click" IsEnabled="{Binding CanMoveUp}" Padding="10,4" MinWidth="34" ToolTip.Tip="Переместить эту программу выше" />
                            <Button Content="↓" Click="MoveApplicationItemDown_Click" IsEnabled="{Binding CanMoveDown}" Padding="10,4" MinWidth="34" ToolTip.Tip="Переместить эту программу ниже" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Собрать из папки…" Click="ScanApplicationFolder_Click" Classes="primary" ToolTip.Tip="Укажите папку с софтом — программа сама найдёт установщики .exe и .msi, включая папки продуктов вроде Office, и заполнит список." />
                    <Button Content="Добавить файлы…" Click="AddApplicationFiles_Click" ToolTip.Tip="Точечное добавление: выберите конкретные .exe или .msi." />
                    <Button Content="Удалить выбранное" Click="RemoveApplication_Click" />
                  </StackPanel>
                  <Border Classes="innerCard" IsVisible="{Binding HasSelectedApplication}">
                    <StackPanel Spacing="6">
                      <TextBlock x:Name="SelectedApplicationNameText" Classes="fieldLabel" />
                      <TextBox x:Name="SelectedApplicationDisplayNameTextBox" PlaceholderText="Понятное название, например «Крипто-сокет x64»" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Разрядность" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="Программа сама определяет разрядность Windows и ставит только подходящий установщик. Профиль может держать обе версии одной программы — лишняя будет пропущена.">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <ComboBox x:Name="SelectedApplicationArchitectureComboBox" HorizontalAlignment="Left" MinWidth="220">
                        <ComboBoxItem Tag="Any">Любая разрядность</ComboBoxItem>
                        <ComboBoxItem Tag="X64">Только 64-разрядная Windows</ComboBoxItem>
                        <ComboBoxItem Tag="X86">Только 32-разрядная Windows</ComboBoxItem>
                      </ComboBox>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Аргументы тихой установки" Classes="fieldLabel" />
                        <Border Classes="helpBadge" ToolTip.Tip="По одному в строке. Без них установщик покажет окна и остановит очередь. Частые варианты: /S (WinRAR, NSIS), /s (Java), /silent /install (Chrome), /qn (файлы .msi), /adminfile (Office).">
                          <TextBlock Classes="helpBadgeText" Text="i" />
                        </Border>
                      </StackPanel>
                      <TextBox x:Name="SelectedApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" PlaceholderText="Например: /S" />
                      <TextBlock x:Name="SelectedApplicationFrameworkHintText" Classes="helperText" TextWrapping="Wrap" Foreground="{StaticResource AccentTextBrush}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Сохранить изменения" Click="UpdateApplicationArguments_Click" />
                        <TextBlock x:Name="SelectedApplicationPathText" Classes="helperText" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Classes="quickActionOnPc">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ДЕЙСТВИЕ НА ЭТОМ ПК" Classes="quickActionLabel" />
                      <Button x:Name="CaptureFootprintButton" Content="Записать эталон с этого ПК" Click="CaptureApplicationFootprint_Click" Classes="ghost" HorizontalAlignment="Left" ToolTip.Tip="Читает папки установки перечисленных приложений и запоминает их размер и число файлов. Делайте это на эталонно настроенной машине. Windows не изменяется." />
                      <TextBlock Text="Проверка потом сравнит папку с эталоном. Рост размера считается нормой — программы копят кэш и обновляются; тревога поднимается, если файлов стало меньше." Classes="helperText" />
                    </StackPanel>
                  </Border>
                  <Expander Header="Заполнить вручную">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                      <TextBlock Text="Нужно, только если установщика нет под рукой или требуется свой ID и аргументы." Classes="helperText" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="ID приложения" Classes="fieldLabel" />
                          <TextBox x:Name="ApplicationIdTextBox" PlaceholderText="example-app" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Отображаемое название" Classes="fieldLabel" />
                          <TextBox x:Name="ApplicationDisplayNameTextBox" PlaceholderText="Пример приложения" />
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Источник" Classes="fieldLabel" />
                          <ComboBox x:Name="ApplicationSourceComboBox">
                            <ComboBoxItem Tag="PackageRelative">Из пакета</ComboBoxItem>
                            <ComboBoxItem Tag="ExternalManual">Внешняя ручная установка</ComboBoxItem>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="Путь внутри пакета" Classes="fieldLabel" />
                          <TextBox x:Name="ApplicationPathTextBox" PlaceholderText="installers/example.msi" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="6">
                        <TextBlock Text="Аргументы, по одному в строке" Classes="fieldLabel" />
                        <TextBox x:Name="ApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                      </StackPanel>
                      <Button Content="Добавить приложение" Click="AddApplication_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="Инструкции" Classes="cardTitle" Margin="0,8,0,0" />
                  <ListBox x:Name="InstructionsList" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,3">
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Id}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ID инструкции" Classes="fieldLabel" />
                      <TextBox x:Name="InstructionIdTextBox" PlaceholderText="post-install" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="Заголовок" Classes="fieldLabel" />
                      <TextBox x:Name="InstructionTitleTextBox" PlaceholderText="После настройки" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6">
                    <TextBlock Text="Текст инструкции" Classes="fieldLabel" />
                    <TextBox x:Name="InstructionContentTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Добавить инструкцию" Click="AddInstruction_Click" />
                    <Button Content="Удалить выбранную инструкцию" Click="RemoveInstruction_Click" />
                  </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="StoragePathPanel" Orientation="Horizontal" Spacing="6" Margin="2,4,2,0">
                <TextBlock Text="Хранилище:" Classes="helperText" />
                <TextBlock x:Name="StoragePathText" TextWrapping="Wrap" Classes="helperText" />
              </StackPanel>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PrepareInstallScrollViewer" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="New USB Install — Windows 11" Classes="cardTitle" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Как подготовить?" Click="OpenNewWindowsDocumentation_Click" Classes="ghost" />
                  </Grid>
                </Border>

                <Border Classes="calloutWarning">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Что флешка настроит сама, а что нет" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
                    <TextBlock Text="Файл ответов настраивает только языки, раскладки, часовой пояс и экраны первичной настройки. Имя, сеть, домен и приложения он не трогает — их нужно применить вручную через «Настроить этот компьютер», потому что автозапуск Easyaller при первом входе в этой сборке пока не включён." TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>


                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                  <TextBlock Text="Целевая версия Windows" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Выберите ISO Windows 11 — редакция, версия и сборка определятся по нему. Без ISO подставлены значения этого компьютера, их можно поправить вручную." Classes="noteText" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBox x:Name="TargetIsoPathTextBox" Grid.Column="0" IsReadOnly="True" PlaceholderText="ISO не выбран" />
                      <Button x:Name="ChooseTargetIsoButton" Grid.Column="1" Content="Выбрать ISO…" Click="ChooseTargetIso_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetIsoStatusText" Classes="helperText" TextWrapping="Wrap" IsVisible="False" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Редакция" Classes="fieldLabel" />
                        <ComboBox x:Name="DeploymentEditionComboBox" SelectionChanged="DeploymentEdition_SelectionChanged">
                          <ComboBoxItem Tag="Professional">Windows 11 Pro</ComboBoxItem>
                          <ComboBoxItem Tag="Enterprise">Windows 11 Enterprise</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Версия" Classes="fieldLabel" />
                        <ComboBox x:Name="DeploymentVersionComboBox" SelectionChanged="DeploymentVersion_SelectionChanged">
                          <ComboBoxItem Tag="24H2">24H2</ComboBoxItem>
                          <ComboBoxItem Tag="25H2">25H2</ComboBoxItem>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Сборка" Classes="fieldLabel" />
                        <TextBox x:Name="DeploymentBuildTextBox" Text="26100" TextChanged="DeploymentBuild_TextChanged" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
                  <TextBlock Text="Проверка и сборка пакета" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Создаётся только папка с файлами. ISO, USB-накопители, диски и настройки текущей Windows не изменяются." Classes="noteText" />
                    <TextBox x:Name="DeploymentPreviewTextBox" Text="Выберите профиль и целевую версию Windows, затем проверьте совместимость." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" Background="{StaticResource SurfaceSunkenBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="3" /></Border>
                  <TextBlock Text="Установочный USB" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Запись на USB — необратимая операция и открывается в отдельном защищённом окне с подтверждением ERASE." Classes="noteText" />
                    <Button Content="Открыть создание установочного USB…" Click="OpenUsbCreator_Click" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
                <Border x:Name="UnifiedApplyHeader" Classes="calloutInfo" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock Text="2. Применить настройки к этому ПК" Classes="panelTitle" />
                    <TextBlock Text="Запускается отдельно и только после подтверждения. Программы этим действием не устанавливаются." Classes="helperText" />
                  </StackPanel>
                </Border>
            <ScrollViewer x:Name="ApplyTabScrollViewer" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="14" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Что сделает выбранный профиль" Classes="cardTitle" />
                    <TextBlock x:Name="PlanSummaryText" Text="Выберите профиль в списке слева." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="1" /></Border>
                  <TextBlock Text="Что будет применено к этому ПК" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <Border Classes="innerCard">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Кнопка «Применить настройки» меняет только параметры Windows из профиля и не запускает установщики. Для софта используйте независимый блок «Установка программ» ниже. Каждый запуск записывается в локальный журнал." Classes="noteText" />
                    <TextBlock x:Name="ApplyPlanStepsText" Text="Выберите профиль, чтобы увидеть список операций." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TimeZoneActionText" Text="Выберите профиль, чтобы увидеть его часовой пояс." Classes="noteText" />
                    <TextBlock x:Name="ApplyNotAutomatedText" Classes="helperText" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="2" /></Border>
                  <TextBlock Text="Значения только для текущего запуска" Classes="panelTitle" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Заполните только те поля, которые запросит план выше. Сами по себе они в профиль не попадают." Classes="noteText" />
                <Border Classes="innerCard">
                  <StackPanel Spacing="7">
                    <TextBlock Text="БЫСТРОЕ ЗАПОЛНЕНИЕ ЭТИХ ПОЛЕЙ" Classes="quickActionLabel" Foreground="{StaticResource AccentTextBrush}" />
                    <WrapPanel Orientation="Horizontal" ItemHeight="34">
                      <Button Content="Взять из профиля" Click="FillRuntimeFromProfile_Click" Classes="ghost" ToolTip.Tip="Подставляет сюда адаптер, прокси, домен и учётную запись, сохранённые в профиле." />
                      <Button Content="Взять с этого ПК" Click="FillRuntimeFromCurrentPc_Click" Classes="ghost" Margin="8,0,0,0" ToolTip.Tip="Подставляет сюда текущие имя компьютера, активный адаптер, прокси и домен Windows." />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Имя компьютера" Classes="fieldLabel" />
                      <Border Classes="requiredTag"><TextBlock Text="Обязательно" Classes="requiredTagText" /></Border>
                    </StackPanel>
                    <TextBox x:Name="RuntimeComputerNameTextBox" PlaceholderText="Имя компьютера" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Имя или GUID сетевого адаптера" Classes="fieldLabel" />
                      <Border Classes="requiredTag"><TextBlock Text="Обязательно" Classes="requiredTagText" /></Border>
                    </StackPanel>
                    <TextBox x:Name="RuntimeNetworkAdapterTextBox" PlaceholderText="Ethernet" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Адрес прокси" Classes="fieldLabel" />
                      <Border x:Name="ProxyRuntimeTag" Classes="requiredTag" IsVisible="False"><TextBlock Text="Обязательно" Classes="requiredTagText" /></Border>
                    </StackPanel>
                    <TextBox x:Name="RuntimeProxyAddressTextBox" PlaceholderText="Только если это запрашивает профиль" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Имя домена" Classes="fieldLabel" />
                      <Border x:Name="DomainRuntimeTag" IsVisible="False"><TextBlock x:Name="DomainRuntimeTagText" /></Border>
                    </StackPanel>
                    <TextBox x:Name="RuntimeDomainNameTextBox" PlaceholderText="Только при присоединении к домену" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="Имя пользователя домена" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeDomainUserNameTextBox" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                    <TextBlock Text="Пароль домена" Classes="fieldLabel" />
                    <TextBox x:Name="RuntimeDomainPasswordTextBox" PasswordChar="•" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Пароль и адрес прокси хранятся в памяти только на время проверки или применения. Они никогда не сохраняются в профиле, состоянии resume или журнале." Classes="noteText" />

                <StackPanel x:Name="ManualInstructionsPanel" IsVisible="False" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="stepBadge"><TextBlock Classes="stepBadgeText" Text="4" /></Border>
                    <TextBlock Text="Ручные шаги из профиля" Classes="panelTitle" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="Эти шаги Easyaller не выполняет — они описаны в профиле как памятка оператору. Текст никогда не исполняется как команда." Classes="noteText" />
                  <ItemsControl x:Name="ManualInstructionsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:InstructionListItem}">
                        <Border Classes="innerCard" Margin="0,0,0,8">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Text="Результат применения" Classes="cardTitle" Margin="0,8,0,0" />
                <TextBox x:Name="ApplyResultTextBox" Text="Пока ничего не применялось." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" Background="{StaticResource SurfaceSunkenBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />
              </StackPanel>
            </ScrollViewer>
                <Border x:Name="UnifiedVerifyHeader" Classes="calloutInfo" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock Text="3. Проверить результат" Classes="panelTitle" />
                    <TextBlock Text="Проверка только читает текущее состояние Windows и сравнивает его с профилем. Никакие настройки и программы не запускаются." Classes="helperText" />
                  </StackPanel>
                </Border>
            <ScrollViewer x:Name="VerifyTabScrollViewer" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
              <StackPanel Spacing="12" Margin="0,8,0,0">
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Соответствует ли этот компьютер профилю" Classes="cardTitle" />
                    <TextBlock Text="Сверка только читает настройки Windows и ничего не меняет. Пункты, которые профиль не описывает, помечаются как «не задано»." TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                  </StackPanel>
                </Border>

                <Border x:Name="ComplianceSummaryPanel" IsVisible="False" Classes="innerCard">
                  <StackPanel Spacing="4">
                    <TextBlock x:Name="ComplianceSummaryText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ComplianceSummaryDetailText" Classes="helperText" />
                  </StackPanel>
                </Border>

                <ListBox x:Name="ComplianceList" Background="Transparent" BorderThickness="0" MinHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ComplianceCheckListItem}">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="4,6">
                        <Border Width="8" Height="8" CornerRadius="999" VerticalAlignment="Center" Background="{Binding StatusBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="helperText" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="ComplianceEmptyText" Text="Нажмите «Проверить этот компьютер», чтобы сверить его с выбранным профилем." Classes="helperText" Margin="2,0" />
              </StackPanel>
            </ScrollViewer>

                <Border x:Name="UnifiedSoftwareBlock" Classes="innerCard" IsVisible="False" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                      <TextBlock Text="4. Установка программ" Classes="panelTitle" />
                      <TextBlock Text="Отдельная очередь установщиков из профиля. Она не запускается кнопкой применения настроек и не участвует в проверке Windows." Classes="helperText" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Открыть установку программ" Click="OpenSoftwareSection_Click" Classes="primary primaryLarge" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="4" x:Name="VerifyBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Проверка только читает состояние компьютера. Отчёт не содержит паролей." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="42" HorizontalAlignment="Left">
                  <Button x:Name="RunComplianceCheckButton" Content="Проверить этот компьютер" Click="RunComplianceCheck_Click" Classes="primary primaryLarge" />
                  <Button x:Name="SaveComplianceReportButton" Content="Сохранить отчёт…" Click="SaveComplianceReport_Click" Classes="ghost" IsEnabled="False" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" x:Name="ApplyBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Эта кнопка применяет только настройки Windows из выбранного профиля. Программы не устанавливаются, проверка не запускается." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="46" HorizontalAlignment="Left">
                  <Button Content="Проверить значения без изменений" Click="ValidateRuntimeInputs_Click" Classes="ghost" />
                  <Button x:Name="ApplyRuntimeInputsButton" Content="Применить настройки" Click="ApplyRuntimeInputs_Click" Classes="warningAction primaryLarge" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="4" x:Name="ProfileSectionBottomBar" IsVisible="False" Classes="bottomBar">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="Изменения в полях сначала сохраняются только в профиле." Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                  <TextBlock Text="Кнопки «Применить … на этом ПК» внутри раздела меняют только соответствующую группу настроек." Classes="helperText" />
                </StackPanel>
                <Button Grid.Column="1" Content="Сохранить раздел в профиль" Click="SaveProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="primary primaryLarge" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Grid.Row="4" x:Name="PrepareBottomBar" IsVisible="False" Classes="bottomBar">
              <StackPanel Spacing="10">
                <TextBlock Text="Шаги выполняются по порядку. Пакет можно сохранить только после безопасного предпросмотра." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="46" HorizontalAlignment="Left">
                  <Button Content="1. Проверить совместимость" Click="PreviewDeployment_Click" Classes="ghost" />
                  <Button Content="2. Безопасный предпросмотр" Click="CreateDryRun_Click" Classes="ghost" Margin="8,0,0,0" />
                  <Button x:Name="ExportDeploymentButton" Content="3. Сохранить пакет в папку" Click="ExportDeploymentPackage_Click" IsEnabled="False" Classes="primary primaryLarge" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border x:Name="SoftwareWorkspace" Grid.Column="1" Classes="contentPane" Padding="14,4,2,2" IsVisible="False">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="Установка программ" Classes="pageTitle" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Профиль:" Classes="helperText" />
                  <TextBlock Text="{Binding SelectedProfileName}" Classes="helperText" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="1" Click="SelectWindowsSettingsSection_Click" Classes="ghost" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7"><materialIcons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" /><TextBlock Text="К разделам" /></StackPanel>
              </Button>
              <Button Grid.Column="2" Content="Сохранить профиль" Click="SaveProfile_Click" IsEnabled="{Binding CanSaveProfile}" Classes="primary" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="Как установить?" Click="OpenApplicationsDocumentation_Click" Classes="ghost" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ApplicationInstallPanel" IsVisible="False" Spacing="12">
                <Border Classes="calloutInfo">
                  <TextBlock x:Name="ApplicationInstallSummaryText" Classes="noteText" TextWrapping="Wrap" />
                </Border>

                <Border Classes="innerCard">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Источник установщиков" Classes="cardTitle" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox x:Name="InstallerRootTextBox" IsReadOnly="True" FontSize="12" Padding="8,5" PlaceholderText="Папка Installers или подключённый ISO с софтом" />
                      <Button Grid.Column="1" Content="Выбрать папку…" Click="ChooseInstallerRoot_Click" Classes="ghost" />
                      <Button Grid.Column="2" x:Name="CheckInstallersButton" Content="Проверить" Click="CheckInstallers_Click" Classes="ghost" ToolTip.Tip="Проверяет файлы и тихие ключи, ничего не устанавливая." />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border x:Name="ResumeInstallQueuePanel" Classes="calloutWarning" IsVisible="False">
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="ResumeInstallQueueText" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" />
                    <WrapPanel Orientation="Horizontal" ItemHeight="40">
                      <Button x:Name="RetryFailedInstallButton" Content="Повторить неудачную" Click="RetryFailedInstall_Click" Classes="warningAction" />
                      <Button x:Name="SkipFailedInstallButton" Content="Пропустить и продолжить" Click="SkipFailedInstall_Click" Classes="ghost" Margin="8,0,0,0" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Classes="innerCard">
                  <StackPanel Spacing="9">
                    <TextBlock Text="Программы из профиля" Classes="cardTitle" />
                    <TextBlock Text="Двойной щелчок по названию устанавливает только выбранную программу. Стрелки меняют порядок всей очереди." Classes="helperText" TextWrapping="Wrap" />
                    <ListBox x:Name="SoftwareApplicationsList" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" MaxHeight="330" SelectionChanged="SoftwareApplicationsList_SelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ApplicationListItem}">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="7,5">
                            <Border Classes="stepBadge" MinWidth="24" Padding="6,2">
                              <TextBlock Text="{Binding QueueNumber}" Classes="stepBadgeText" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" DoubleTapped="ApplicationItem_DoubleTapped" Cursor="Hand" ToolTip.Tip="Двойной щелчок — установить только эту программу">
                              <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Detail}" Classes="helperText" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                              <Button Click="MoveApplicationItemUp_Click" IsEnabled="{Binding CanMoveUp}" Padding="10,4" MinWidth="34" ToolTip.Tip="Выше в очереди"><materialIcons:MaterialIcon Kind="ArrowUp" Width="16" Height="16" /></Button>
                              <Button Click="MoveApplicationItemDown_Click" IsEnabled="{Binding CanMoveDown}" Padding="10,4" MinWidth="34" ToolTip.Tip="Ниже в очереди"><materialIcons:MaterialIcon Kind="ArrowDown" Width="16" Height="16" /></Button>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Orientation="Horizontal" ItemHeight="38">
                      <Button Content="Собрать из папки…" Click="ScanApplicationFolder_Click" Classes="primary" />
                      <Button Content="Добавить файлы…" Click="AddApplicationFiles_Click" Classes="ghost" Margin="8,0,0,0" />
                      <Button Content="Удалить выбранное" Click="RemoveSoftwareApplication_Click" Classes="ghost" Margin="8,0,0,0" />
                    </WrapPanel>

                    <Border x:Name="SoftwareApplicationEditorCard" Classes="calloutInfo" IsVisible="False">
                      <StackPanel Spacing="8">
                        <TextBlock Text="Параметры выбранной программы" Classes="cardTitle" />
                        <Grid ColumnDefinitions="*,240" ColumnSpacing="12">
                          <StackPanel Spacing="5">
                            <TextBlock Text="Название" Classes="fieldLabel" />
                            <TextBox x:Name="SoftwareApplicationDisplayNameTextBox" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Разрядность" Classes="fieldLabel" />
                            <ComboBox x:Name="SoftwareApplicationArchitectureComboBox">
                              <ComboBoxItem Tag="Any">Любая</ComboBoxItem>
                              <ComboBoxItem Tag="X64">Только x64</ComboBoxItem>
                              <ComboBoxItem Tag="X86">Только x86</ComboBoxItem>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="Аргументы тихой установки — по одному в строке" Classes="fieldLabel" />
                        <TextBox x:Name="SoftwareApplicationArgumentsTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
                        <TextBlock x:Name="SoftwareSelectedApplicationPathText" Classes="helperText" TextWrapping="Wrap" />
                        <Button Content="Сохранить параметры программы" Click="SaveSoftwareApplication_Click" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <TextBox x:Name="ApplicationInstallResultTextBox" IsVisible="False" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" Background="{StaticResource SurfaceSunkenBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" />

                <Border Classes="calloutInfo">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Последние установки" Classes="fieldLabel" />
                    <TextBlock x:Name="ApplicationInstallHistoryText" Text="Установки ещё не выполнялись." Classes="noteText" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Classes="bottomBar">
              <StackPanel Spacing="8">
                <TextBlock Text="Устанавливаются только программы. Настройки Windows, сеть и домен не применяются." Classes="helperText" />
                <WrapPanel Orientation="Horizontal" ItemHeight="46">
                  <Button x:Name="InstallApplicationsButton" Content="Установить всё по очереди" Click="InstallApplications_Click" Classes="warningAction primaryLarge" IsEnabled="False" />
                  <Button x:Name="CancelApplicationInstallButton" Content="Остановить установку" Click="CancelApplicationInstall_Click" Classes="ghost" IsVisible="False" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="MaintenanceWorkspace" Grid.Row="1" Classes="panelCard" Padding="18" IsVisible="False">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock Text="Обслуживание этого компьютера" Classes="pageTitle" />
                <TextBlock Text="Самостоятельные операции для уже настроенной Windows. Они не входят в профиль новой установки и запускаются только вручную." Classes="helperText" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Как выполнить?" Click="OpenMaintenanceDocumentation_Click" Classes="ghost" VerticalAlignment="Center" />
            </Grid>

            <Border Classes="innerCard">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Скопировать ярлыки пользователю" Classes="cardTitle" />
                  <TextBlock Text="Выберите профиль пользователя и папку «Ярлыки». На рабочий стол копируются только файлы .lnk, .url и .website; сами программы не запускаются." Classes="noteText" TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Пользователь Windows" Classes="fieldLabel" />
                    <ComboBox x:Name="MaintenanceUserComboBox" MinWidth="320" SelectionChanged="MaintenanceUserComboBox_SelectionChanged">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LocalWindowsUser}">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProfileDirectory}" Classes="helperText" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Обновить список" Click="RefreshMaintenanceUsers_Click" Classes="ghost" VerticalAlignment="Bottom" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Папка с ярлыками" Classes="fieldLabel" />
                    <TextBox x:Name="ShortcutSourceTextBox" IsReadOnly="True" PlaceholderText="Выберите папку «Ярлыки»" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Выбрать папку…" Click="ChooseShortcutSource_Click" Classes="ghost" VerticalAlignment="Bottom" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Рабочий стол назначения" Classes="fieldLabel" />
                    <TextBox x:Name="ShortcutTargetDesktopTextBox" IsReadOnly="True" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Если ярлык уже существует" Classes="fieldLabel" />
                    <ComboBox x:Name="ShortcutConflictComboBox" SelectedIndex="0" SelectionChanged="ShortcutConflictComboBox_SelectionChanged">
                      <ComboBoxItem Tag="Skip">Не заменять</ComboBoxItem>
                      <ComboBoxItem Tag="Replace">Заменить файлом из папки</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Border Classes="calloutInfo">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Предварительный просмотр" Classes="fieldLabel" />
                    <TextBlock x:Name="ShortcutPreviewText" Text="Выберите пользователя и папку-источник." Classes="noteText" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <WrapPanel Orientation="Horizontal" ItemHeight="42">
                  <Button Content="Проверить список" Click="PreviewShortcuts_Click" Classes="ghost" />
                  <Button x:Name="CopyShortcutsButton" Content="Скопировать на рабочий стол" Click="CopyShortcuts_Click" Classes="primary primaryLarge" IsEnabled="False" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="innerCard">
              <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                  <TextBlock Text="Архивация писем Outlook" Classes="cardTitle" />
                  <TextBlock Text="Работает с классическим Outlook текущего вошедшего пользователя. Сначала Easyaller только считает письма старше указанного срока; перенос в PST запускается отдельно после подтверждения." Classes="noteText" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Папки для архивации" Classes="fieldLabel" />
                    <Border Classes="calloutInfo">
                      <TextBlock x:Name="OutlookStandardFoldersText" Text="Входящие и Отправленные" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="LoadOutlookFoldersButton" Content="Подключить Outlook" Click="LoadOutlookFolders_Click" Classes="ghost" VerticalAlignment="Bottom" />
                </Grid>
                <Grid ColumnDefinitions="220,*" ColumnSpacing="14">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Архивировать письма старше" Classes="fieldLabel" />
                    <ComboBox x:Name="OutlookAgeComboBox" SelectedIndex="0" SelectionChanged="OutlookArchiveInput_Changed">
                      <ComboBoxItem Tag="AllTime">За всё время</ComboBoxItem>
                      <ComboBoxItem Tag="TwoWeeks">Старше 2 недель</ComboBoxItem>
                      <ComboBoxItem Tag="OneMonth">Старше 1 месяца</ComboBoxItem>
                      <ComboBoxItem Tag="ThreeMonths">Старше 3 месяцев</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Файл архива PST (по умолчанию: Документы\Файлы Outlook\сегодняшняя дата.pst)" Classes="fieldLabel" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBox x:Name="OutlookArchivePathTextBox" IsReadOnly="True" PlaceholderText="Выберите новый или существующий файл .pst" />
                      <Button Grid.Column="1" Content="Выбрать файл…" Click="ChooseOutlookArchivePath_Click" Classes="ghost" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="7">
                    <TextBlock x:Name="OutlookArchivePreviewText" Text="Загрузите папки Outlook и выберите параметры архивации." Classes="noteText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="OutlookArchiveProgressBar" Minimum="0" Maximum="100" Value="0" IsVisible="False" Height="8" />
                  </StackPanel>
                </Border>
                <WrapPanel Orientation="Horizontal" ItemHeight="42">
                  <Button x:Name="PreviewOutlookArchiveButton" Content="Посчитать письма" Click="PreviewOutlookArchive_Click" Classes="ghost" IsEnabled="False" />
                  <Button x:Name="RunOutlookArchiveButton" Content="Переместить письма в PST" Click="RunOutlookArchive_Click" Classes="warningAction primaryLarge" IsEnabled="False" Margin="8,0,0,0" />
                  <Button x:Name="CancelOutlookArchiveButton" Content="Остановить" Click="CancelOutlookArchive_Click" Classes="ghost" IsVisible="False" Margin="8,0,0,0" />
                </WrapPanel>
                <Border Classes="calloutInfo">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Последние архивации" Classes="fieldLabel" />
                    <TextBlock x:Name="OutlookArchiveHistoryText" Text="Архивации ещё не выполнялись." Classes="noteText" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,10">
        <Border IsVisible="{Binding HasStatusMessage}" Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="6" Padding="12,8" Margin="0,8,0,0" MinHeight="92" MaxHeight="180">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
          </ScrollViewer>
        </Border>
        <Border x:Name="ImportConflictPanel" IsVisible="False" Classes="calloutWarning">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Профиль с таким ID уже существует. Выберите действие." VerticalAlignment="Center" Foreground="{StaticResource WarningTextBrush}" />
            <Button Grid.Column="1" Content="Создать копию" Click="ImportCreateCopy_Click" />
            <Button Grid.Column="2" Content="Заменить" Click="ImportReplace_Click" Classes="warningAction" />
            <Button Grid.Column="3" Content="Отмена" Click="ImportCancel_Click" Classes="ghost" />
          </Grid>
        </Border>
        <Border x:Name="ExportConfirmationPanel" IsVisible="False" Classes="calloutInfo">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="ExportWarningText" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
            <Button Grid.Column="1" Content="Подтвердить экспорт" Click="ConfirmExport_Click" Classes="primary" />
            <Button Grid.Column="2" Content="Отмена" Click="CancelExport_Click" Classes="ghost" />
          </Grid>
        </Border>
      </StackPanel>
  </Grid>
</Window>
