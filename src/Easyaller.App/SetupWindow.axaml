<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Easyaller.App"
        x:Class="Easyaller.App.SetupWindow"
        Title="Easyaller - Применить профиль на этом ПК"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="580"
        Background="#101826">
  <Grid RowDefinitions="Auto,*,Auto" Margin="30">
    <StackPanel Spacing="6" Margin="0,0,0,24">
      <TextBlock Text="Применить профиль на этом ПК" FontSize="29" FontWeight="SemiBold" Foreground="#F7F9FE" />
      <TextBlock Text="Здесь можно безопасно просмотреть план, подготовить только файлы Windows 11 или применить подтверждённые настройки к текущему компьютеру. Изменения Windows требуют ввода APPLY и прав администратора." Foreground="#A9B7CD" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="20">
      <Border Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Профили" FontWeight="SemiBold" Foreground="#EAF0FA" Margin="8,6,8,12" />
          <ListBox x:Name="SetupProfilesList" Grid.Row="1" SelectionChanged="SetupProfilesList_SelectionChanged" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:ProfileListItem}">
                <StackPanel Margin="8,6" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#EDF3FC" />
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#9EB0CC" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="#172233" BorderBrush="#2A3B55" BorderThickness="1" CornerRadius="12" Padding="26">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16">
            <TextBlock x:Name="SelectedProfileText" Text="Выберите профиль" FontSize="22" FontWeight="SemiBold" Foreground="#F7F9FE" />
            <Border Background="#1D2A3E" CornerRadius="8" Padding="14">
              <StackPanel Spacing="5">
                <TextBlock Text="Что сделает выбранный профиль" FontWeight="SemiBold" Foreground="#EAF0FA" />
                <TextBlock x:Name="PlanSummaryText" Text="План не выбран." TextWrapping="Wrap" Foreground="#A9B7CD" />
              </StackPanel>
            </Border>
            <Border Background="#1D2A3E" BorderBrush="#35667E" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel Spacing="12">
                <TextBlock Text="Подготовить файлы для установки Windows 11" FontWeight="SemiBold" Foreground="#EAF0FA" />
                <TextBlock Text="Это отдельный безопасный шаг: создаётся только папка с файлами. ISO, USB-накопители, диски и настройки текущей Windows не изменяются." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Редакция" FontSize="12" Foreground="#A9B7CD" />
                    <ComboBox x:Name="DeploymentEditionComboBox" SelectionChanged="DeploymentEdition_SelectionChanged">
                      <ComboBoxItem Tag="Professional">Windows 11 Pro</ComboBoxItem>
                      <ComboBoxItem Tag="Enterprise">Windows 11 Enterprise</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Версия" FontSize="12" Foreground="#A9B7CD" />
                    <ComboBox x:Name="DeploymentVersionComboBox" SelectionChanged="DeploymentVersion_SelectionChanged">
                      <ComboBoxItem Tag="24H2">24H2</ComboBoxItem>
                      <ComboBoxItem Tag="25H2">25H2</ComboBoxItem>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="Сборка" FontSize="12" Foreground="#A9B7CD" />
                    <TextBox x:Name="DeploymentBuildTextBox" Text="26100" TextChanged="DeploymentBuild_TextChanged" />
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="1. Проверить совместимость" Click="PreviewDeployment_Click" />
                  <Button Content="2. Создать безопасный предпросмотр" Click="CreateDryRun_Click" Background="#2D6CDF" Foreground="White" />
                  <Button x:Name="ExportDeploymentButton" Content="3. Сохранить пакет в папку" Click="ExportDeploymentPackage_Click" IsEnabled="False" />
                </StackPanel>
                <TextBox x:Name="DeploymentPreviewTextBox" Text="Выберите профиль и целевую версию Windows, затем проверьте совместимость." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="108" Background="#101826" Foreground="#C7D7EE" BorderThickness="0" />
              </StackPanel>
            </Border>
            <TextBlock Text="Данные только для этого компьютера" FontWeight="SemiBold" Foreground="#EAF0FA" />
            <TextBlock Text="Заполните только те поля, которые запросит план выше. Значения не добавляются в профиль." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
            <ListBox x:Name="RuntimePromptsList" Height="116" Background="#1D2A3E" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:RuntimePromptListItem}">
                  <StackPanel Margin="8,4" Spacing="2">
                    <TextBlock Text="{Binding Title}" Foreground="#EDF3FC" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#9EB0CC" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Значения только для текущего запуска" FontWeight="SemiBold" Foreground="#EAF0FA" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Имя компьютера" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ComputerNameTextBox" PlaceholderText="Например, LAB-WS-01" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Имя или GUID сетевого адаптера" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="NetworkAdapterTextBox" PlaceholderText="Точное имя адаптера из Windows" />
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="6">
                <TextBlock Text="Адрес прокси" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="ProxyAddressTextBox" PlaceholderText="Только если это запрашивает профиль" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <TextBlock Text="Имя домена" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="DomainNameTextBox" PlaceholderText="Только при присоединении к домену" />
              </StackPanel>
              <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="Имя пользователя домена" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="DomainUserNameTextBox" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                <TextBlock Text="Пароль домена" FontSize="12" Foreground="#A9B7CD" />
                <TextBox x:Name="DomainPasswordTextBox" PasswordChar="•" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Пароль и адрес прокси хранятся в памяти только на время проверки или применения. Они никогда не сохраняются в профиле, состоянии resume или журнале." TextWrapping="Wrap" FontSize="12" Foreground="#93C5FD" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Проверить значения без изменений" Click="ValidateRuntimeInputs_Click" Background="#2D6CDF" Foreground="White" />
              <TextBox x:Name="ApplyConfirmationTextBox" Width="180" PlaceholderText="После проверки введите APPLY" />
              <Button x:Name="ApplyRuntimeInputsButton" Content="Применить к этому ПК" Click="ApplyRuntimeInputs_Click" Background="#B45309" Foreground="White" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#182537" CornerRadius="8" Padding="14" Margin="0,20,0,0">
      <TextBlock x:Name="SetupStatusText" Text="Выберите профиль, чтобы посмотреть его план настройки." Foreground="#B7C7E1" />
    </Border>
  </Grid>
</Window>
