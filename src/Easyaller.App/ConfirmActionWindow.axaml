<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Easyaller.App.ConfirmActionWindow"
        Title="Подтверждение"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
  <StackPanel Margin="22,20" Spacing="14">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>

    <Border Classes="calloutWarning">
      <StackPanel Spacing="6">
        <TextBlock x:Name="WarningHeadlineText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="ConsequenceText" TextWrapping="Wrap" Classes="helperText" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Content="Отмена" Click="Cancel_Click" Classes="ghost" IsCancel="True" />
      <Button Grid.Column="2" x:Name="ConfirmButton" Content="Выполнить" Click="Confirm_Click" Classes="warningAction" IsDefault="True" />
    </Grid>
  </StackPanel>
</Window>
