<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Easyaller.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,9" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.helpBadge">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="#284564" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="TextBlock.helpBadgeText">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#C8E3FF" />
    </Style>
    <Style Selector="Expander.profileSection /template/ ToggleButton">
      <Setter Property="Background" Value="#1D2A3E" />
      <Setter Property="BorderBrush" Value="#2A3B55" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16,11" />
    </Style>
    <Style Selector="Expander.profileSection /template/ ToggleButton:pointerover">
      <Setter Property="Background" Value="#22344D" />
      <Setter Property="BorderBrush" Value="#3A5A81" />
    </Style>
  </Application.Styles>
</Application>
